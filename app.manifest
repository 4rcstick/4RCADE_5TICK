<?xml version="1.0" encoding="utf-8"?>
<!-- Application manifest. Declares Per-Monitor V2 DPI awareness, so every window renders sharp at each monitor's own
     Windows scale and gets DpiChanged when it moves between monitors (Smart fullscreen needs the true physical
     monitor size and DPI). Without it WPF runs System DPI aware and Windows bitmap-stretches the app on any monitor
     whose scale differs from the primary one. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="4RCADE5TICK.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
