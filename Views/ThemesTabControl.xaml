<UserControl x:Class="ArcadeStick.Views.ThemesTabControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick.Views"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <!-- Theme Builder property sync points live in code-behind (ThemesTabControl.xaml.cs):
         LoadCurrentThemeValuesIntoUi(), the themeDto builder in BtnSaveTheme_Click, and
         BtnLoadTheme_Click. Any new theme control added here must be wired into all three,
         or it will silently revert to XAML defaults - see project notes on Theme Builder sync points. -->
    <Grid>
        <ScrollViewer Margin="0,5,5,5" VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewer}">
            <StackPanel Margin="15">

                <!-- [SECTION: Theme Builder Guide] -->
                <TextBlock Text="THEME BUILDER GUIDE" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,10"/>
                <TextBlock Text="Select an existing theme and click Load Theme to edit it, or choose [New Theme...] and enter a name to start fresh. Save Changes writes your edits to the named theme file and applies them immediately. Save Adjustments (below) only saves your current settings so they persist on next launch, without updating the theme file itself. Delete Theme permanently removes the selected theme." Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,0,0,15"/>
                <!-- [END SECTION: Theme Builder Guide] -->

                <!-- [SECTION: Themes Manager] -->
                <!-- Custom-templated ComboBox listing saved themes (+ "New Theme..."), a conditional
                 New Theme Name field, and Load/Save-Apply/Delete buttons. -->
                <TextBlock Text="THEMES MANAGER" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Active Theme:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CboThemePresets" Width="180" Height="25" Style="{StaticResource ChromeComboBoxStyle}"/>
                    </StackPanel>

                    <!-- Only visible when "[New Theme...]" is selected in the dropdown above -->
                    <StackPanel Grid.Column="0" Grid.Row="2" x:Name="PnlNewThemeName" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="New Theme Name:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtNewThemeName" Width="151" Height="25" Style="{StaticResource GLTextBoxStyle}"/>
                    </StackPanel>

                    <!-- Load / Save-Apply / Delete theme actions -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0">
                        <Button x:Name="BtnLoadTheme" Content="Load Theme" Width="Auto" Height="Auto" 
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                        <Button x:Name="BtnSaveTheme" Content="Save Changes" Width="Auto" Height="Auto" 
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                        <Button x:Name="BtnDeleteTheme" Content="Delete Theme" Width="Auto" Height="Auto"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3"/>
                    </StackPanel>
                </Grid>


                <!-- [END SECTION: Themes Manager] -->

                <!-- ===== TEMP INSERTION POINT - MOVE THIS WHOLE BLOCK BELOW [END SECTION: Main Window] ===== -->

               
                <!-- Old [SECTION: Background Colors] removed entirely - Content Area Background Color(formerly "Options Window Content") migrated into [SECTION: Options Menu] above. -->

                
                <!-- Old [SECTION: Options Menu] removed entirely: its fonts, backgrounds, border and separator rows
                 moved to the Global tab's Fonts and Backgrounds subtabs (Pass 3), its tab and button rows to the
                 Tabs and Buttons subtabs (Pass 4). -->

                 <!-- Old [SECTION: Tab Options] removed entirely - fully consolidated into
                 [SECTION: Options Menu] above. -->

               <!-- Old [SECTION: Border and Line Options] removed entirely. BorderColorFramework has no input
                 field; it is being replaced by the fixed ChromeBorder palette color (the swatch borders in this
                 file already use it). Separator Color moved to the Global tab's Backgrounds subtab (Pass 3). -->

               <!-- Old [SECTION: Global Buttons] removed entirely - fully consolidated into
                 [SECTION: Options Menu] above (as the Options Menu/ManagePlaylists button system). -->

                <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,5,0,15"/>

                <!-- [SECTION: Global Scrollbars] -->
                <!-- Feeds ArcadeDarkScrollBar in App.xaml / MainWindow.xaml's local copy -->
                <TextBlock Text="GLOBAL SCROLLBARS" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Main Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                <colorpicker:PortableColorPicker x:Name="ScrollThumbColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ScrollThumbColorPicker_ColorChanged">
                                    <colorpicker:PortableColorPicker.Resources>
                                        <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                    </colorpicker:PortableColorPicker.Resources>
                                </colorpicker:PortableColorPicker>
                            </Border>
                            <TextBox Grid.Column="2" x:Name="TxtScrollThumbColorHex" Text="#FF2C2C2E" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtScrollThumbColorHex_LostFocus"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="Hover Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                <colorpicker:PortableColorPicker x:Name="ScrollThumbHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ScrollThumbHoverColorPicker_ColorChanged">
                                    <colorpicker:PortableColorPicker.Resources>
                                        <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                    </colorpicker:PortableColorPicker.Resources>
                                </colorpicker:PortableColorPicker>
                            </Border>
                            <TextBox Grid.Column="2" x:Name="TxtScrollThumbHoverColorHex" Text="#FF3A3A3C" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtScrollThumbHoverColorHex_LostFocus"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Drag Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                <colorpicker:PortableColorPicker x:Name="ScrollThumbDragColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ScrollThumbDragColorPicker_ColorChanged">
                                    <colorpicker:PortableColorPicker.Resources>
                                        <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                    </colorpicker:PortableColorPicker.Resources>
                                </colorpicker:PortableColorPicker>
                            </Border>
                            <TextBox Grid.Column="2" x:Name="TxtScrollThumbDragColorHex" Text="#FF00D4FF" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtScrollThumbDragColorHex_LostFocus"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="2">
                        <TextBlock Text="Track Background:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                <colorpicker:PortableColorPicker x:Name="ScrollTrackColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ScrollTrackColorPicker_ColorChanged">
                                    <colorpicker:PortableColorPicker.Resources>
                                        <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                    </colorpicker:PortableColorPicker.Resources>
                                </colorpicker:PortableColorPicker>
                            </Border>
                            <TextBox Grid.Column="2" x:Name="TxtScrollTrackColorHex" Text="#FF000000" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtScrollTrackColorHex_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Track Hover Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,3"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="ScrollTrackHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ScrollTrackHoverColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="2" x:Name="TxtScrollTrackHoverColorHex" Text="#FF1C1C1E" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtScrollTrackHoverColorHex_LostFocus"/>
                    </Grid>
                </Grid>
                <!-- [END SECTION: Global Scrollbars] -->
                <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,5,0,15"/>

                <!-- [SECTION: Context Menus] -->
                <TextBlock Text="CONTEXT MENUS" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="Font Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                    <TextBlock Grid.Column="4" Grid.ColumnSpan="3" Text="Icon Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                    <TextBlock Grid.Column="8" Grid.ColumnSpan="3" Text="Background Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuFontColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuFontColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="2" x:Name="TxtContextMenuFontColorHex" Text="#FFF2F2F7" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtContextMenuFontColorHex_LostFocus"/>
                    <Border Grid.Column="4" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuIconColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuIconColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="6" x:Name="TxtContextMenuIconColorHex" Text="#FF00D4FF" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtContextMenuIconColorHex_LostFocus"/>
                    <Border Grid.Column="8" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuBgColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="10" x:Name="TxtContextMenuBgColorHex" Text="#FF1C1C1E" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtContextMenuBgColorHex_LostFocus"/>
                </Grid>

                <!-- Font & Icon Hover Color / Font & Icon Hover BG Color (NEW - placeholder) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font &amp; Icon Hover Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                    <TextBlock Grid.Column="2" Text="Font &amp; Icon Hover BG Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                </Grid>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuHoverColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="2" x:Name="TxtContextMenuHoverColorHex" Text="#FFFFFFFF" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtContextMenuHoverColorHex_LostFocus"/>
                    <Border Grid.Column="4" Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuHoverBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuHoverBgColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="6" x:Name="TxtContextMenuHoverBgColorHex" Text="#FF2C2C2E" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtContextMenuHoverBgColorHex_LostFocus"/>
                </Grid>
                <!-- [END SECTION: Context Menus] -->
            </StackPanel>
        </ScrollViewer>

        <!-- Transient "Theme Saved" confirmation flash, toggled visible briefly by code-behind after a save -->
        <TextBlock x:Name="TxtThemeSavedFlash" Text="Theme Saved" Foreground="#4CD964" Background="#000000" Padding="6,3" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,35,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>