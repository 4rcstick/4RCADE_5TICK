<UserControl x:Class="ArcadeStick.Views.ThemesTabControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick.Views"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <!-- Theme Builder property sync points live in code-behind (ThemesTabControl.xaml.cs):
         LoadCurrentThemeValuesIntoUi(), the themeDto builder in BtnSaveTheme_Click, and
         BtnLoadTheme_Click. Any new theme control added here must be wired into all three,
         or it will silently revert to XAML defaults - see project notes on Theme Builder sync points. -->
    <Grid>
        <ScrollViewer Margin="0,5,5,5" VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewer}">
            <StackPanel Margin="15">

                <!-- [SECTION: Theme Builder Guide] -->
                <TextBlock Text="THEME BUILDER GUIDE" Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" FontWeight="Bold" FontSize="{Binding HeaderFontSize, FallbackValue=14}" Margin="0,0,0,10"/>
                <TextBlock Text="Select an existing theme and click Load Theme to edit it, or choose [New Theme...] and enter a name to start fresh. Save Changes writes your edits to the named theme file and applies them immediately. Save Adjustments (below) only saves your current settings so they persist on next launch, without updating the theme file itself. Delete Theme permanently removes the selected theme." Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>
                <!-- [END SECTION: Theme Builder Guide] -->

                <!-- [SECTION: Themes Manager] -->
                <!-- Custom-templated ComboBox listing saved themes (+ "New Theme..."), a conditional
                 New Theme Name field, and Load/Save-Apply/Delete buttons. -->
                <TextBlock Text="THEMES MANAGER" Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" FontWeight="Bold" FontSize="{Binding HeaderFontSize, FallbackValue=14}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Active Theme:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CboThemePresets" Width="180" Height="25" 
          Foreground="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton" Focusable="false" 
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}" 
                                    BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}" 
                                    BorderThickness="1">
                                                        <Path x:Name="Arrow" 
                                      Fill="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}" 
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" 
                                  Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,25,0" 
                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <Border x:Name="DropDownBorder" 
                                Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}" 
                                BorderThickness="1" 
                                BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                    <Setter Property="Foreground" Value="{Binding DataContext.StandardColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                            <Setter Property="Foreground" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </StackPanel>

                    <!-- Only visible when "[New Theme...]" is selected in the dropdown above -->
                    <StackPanel Grid.Column="0" Grid.Row="2" x:Name="PnlNewThemeName" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="New Theme Name:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtNewThemeName" Width="151" Height="25" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4"/>
                    </StackPanel>

                    <!-- Load / Save-Apply / Delete theme actions -->
                    <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0">
                        <Button x:Name="BtnLoadTheme" Content="Load Theme" Width="Auto" Height="Auto" 
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}" 
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}" 
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}" 
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                        <Button x:Name="BtnSaveTheme" Content="Save Changes" Width="Auto" Height="Auto" 
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}" 
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FFD60A}" 
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FFD60A}" 
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                        <Button x:Name="BtnDeleteTheme" Content="Delete Theme" Width="Auto" Height="Auto"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}" 
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FF453A}" 
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FF453A}" 
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3"/>
                    </StackPanel>
                </Grid>


                <!-- [END SECTION: Themes Manager] -->

                <!-- ===== TEMP INSERTION POINT - MOVE THIS WHOLE BLOCK BELOW [END SECTION: Main Window] ===== -->

                <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,5,0,15"/>

                <!-- [SECTION: Main Window] -->
                <!-- Consolidates Main Window background image/color/disable-checkbox (carried over unchanged
                 from the old Background Images/Background Colors sections) with new Search field theming and
                 a Main-Window-specific button system (distinct from the Options Menu/ManagePlaylists button
                 system in [SECTION: Global Buttons]). Fields marked NEW below are placeholder-only - no
                 ConfigurationSettings/ThemeSettings/sync-point wiring yet. -->
                <TextBlock Text="MAIN WINDOW" Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" FontWeight="Bold" FontSize="{Binding HeaderFontSize, FallbackValue=14}" Margin="0,0,0,10"/>

                <!-- Background Image + Background Color (CARRIED OVER - unchanged bindings) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Background Image:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    <TextBlock Grid.Column="3" Grid.ColumnSpan="3" Text="Background Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                </Grid>
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtMainBgPath" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4"/>
                    <Button Grid.Column="1" x:Name="BtnBrowseMainBg" Click="BtnBrowseFile_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#2C2C2E}" 
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=White}" 
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#3A3A3C}" BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"
                        Margin="5,0,0,0"/>
                    <Border Grid.Column="3" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="MainColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="MainColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="Name" Value="MainGrid">
                                            <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="colorpicker:HexColorTextBox">
                                    <Style.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="5" x:Name="TxtMainColorHex" Text="#FF1C1C1E" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtMainColorHex_LostFocus"/>
                </Grid>
                <CheckBox x:Name="ChkDisableMainBgImage" Content="Disable Main Window Background Image (use solid Main Window Background Color only)" Foreground="{Binding StandardColorHex, FallbackValue=White}" FontSize="{Binding StandardFontSize, FallbackValue=12}" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <!-- Search Label Font Size/Color + Background Color (NEW - placeholder) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search Label Font Size/Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    <TextBlock Grid.Column="2" Text="Search Label Background Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSearchLabelFontSize" HorizontalContentAlignment="Center" Text="13" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4"/>
                        <Border Grid.Column="2" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="SearchLabelColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SearchLabelColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Name" Value="MainGrid">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="colorpicker:HexColorTextBox">
                                        <Style.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="4" x:Name="TxtSearchLabelColorHex" Text="#FF00D4FF" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtSearchLabelColorHex_LostFocus"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="SearchLabelBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SearchLabelBgColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Name" Value="MainGrid">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="colorpicker:HexColorTextBox">
                                        <Style.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="2" x:Name="TxtSearchLabelBgColorHex" Text="#001C1C1E" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtSearchLabelBgColorHex_LostFocus"/>
                    </Grid>
                </Grid>

                <!-- Search Box Font Size/Color + Background Color (NEW - placeholder) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search Box Font Size/Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    <TextBlock Grid.Column="2" Text="Search Box Background Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtSearchBoxFontSize" HorizontalContentAlignment="Center" Text="13" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4"/>
                        <Border Grid.Column="2" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="SearchBoxColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SearchBoxColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Name" Value="MainGrid">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="colorpicker:HexColorTextBox">
                                        <Style.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="4" x:Name="TxtSearchBoxColorHex" Text="#FFF2F2F7" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtSearchBoxColorHex_LostFocus"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="SearchBoxBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SearchBoxBgColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Name" Value="MainGrid">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="colorpicker:HexColorTextBox">
                                        <Style.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="2" x:Name="TxtSearchBoxBgColorHex" Text="#FF1C1C1E" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtSearchBoxBgColorHex_LostFocus"/>
                    </Grid>
                </Grid>

                <!-- Main Window Buttons - Font Size/Color + Background Color (NEW - placeholder, separate system from Global Buttons) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Button Font Size/Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    <TextBlock Grid.Column="2" Text="Button Background Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtMainWinBtnFontSize" HorizontalContentAlignment="Center" Text="13" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4"/>
                        <Border Grid.Column="2" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="MainWinBtnColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="MainWinBtnColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Name" Value="MainGrid">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="colorpicker:HexColorTextBox">
                                        <Style.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="4" x:Name="TxtMainWinBtnColorHex" Text="#FF00D4FF" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtMainWinBtnColorHex_LostFocus"/>
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                            <colorpicker:PortableColorPicker x:Name="MainWinBtnBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="MainWinBtnBgColorPicker_ColorChanged">
                                <colorpicker:PortableColorPicker.Resources>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <Trigger Property="Name" Value="MainGrid">
                                                <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="colorpicker:HexColorTextBox">
                                        <Style.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </colorpicker:PortableColorPicker.Resources>
                            </colorpicker:PortableColorPicker>
                        </Border>
                        <TextBox Grid.Column="2" x:Name="TxtMainWinBtnBgColorHex" Text="#FF1C1C1E" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtMainWinBtnBgColorHex_LostFocus"/>
                    </Grid>
                </Grid>

                <!-- Main Window Buttons - Font Color (Hover) + Background Color (Hover) (NEW - placeholder) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Button Font Color (Hover):" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
