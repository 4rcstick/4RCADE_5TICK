                    <TextBox Grid.Column="10" x:Name="TxtContextMenuBgColorHex" Text="#FF1C1C1E" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtContextMenuBgColorHex_LostFocus"/>
                </Grid>

                <!-- Font & Icon Hover Color / Font & Icon Hover BG Color (NEW - placeholder) -->
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Font &amp; Icon Hover Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    <TextBlock Grid.Column="2" Text="Font &amp; Icon Hover BG Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                </Grid>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuHoverColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="Name" Value="MainGrid">
                                            <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="colorpicker:HexColorTextBox">
                                    <Style.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="2" x:Name="TxtContextMenuHoverColorHex" Text="#FFFFFFFF" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtContextMenuHoverColorHex_LostFocus"/>
                    <Border Grid.Column="4" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="ContextMenuHoverBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ContextMenuHoverBgColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="Name" Value="MainGrid">
                                            <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="colorpicker:HexColorTextBox">
                                    <Style.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="6" x:Name="TxtContextMenuHoverBgColorHex" Text="#FF2C2C2E" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtContextMenuHoverBgColorHex_LostFocus"/>
                </Grid>
                <!-- [END SECTION: Context Menus] -->
            </StackPanel>
        </ScrollViewer>

        <!-- Transient "Theme Saved" confirmation flash, toggled visible briefly by code-behind after a save -->
        <TextBlock x:Name="TxtThemeSavedFlash" Text="Theme Saved" Foreground="#4CD964" Background="#000000" Padding="6,3" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,35,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>