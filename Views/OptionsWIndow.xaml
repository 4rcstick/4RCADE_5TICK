<Window x:Class="ArcadeStick.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        xmlns:views="clr-namespace:ArcadeStick.Views"
        Title="4RCADE 5TICK Options" Height="700" Width="680"
        WindowStartupLocation="CenterOwner" 
        Background="{DynamicResource Global.Options.Bg}" 
        BorderBrush="{StaticResource ChromeBorder}"
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="OptionsTabControl" Grid.Row="0" Style="{StaticResource ThemedTabControlStyle}">
            <!-- Tab strip, headers and framed content area come from the shared Themed Tab Styles in App.xaml
                 (Global Tabs and Backgrounds resources). -->

            <!-- [SECTION: Tab Pages] -->
            <!-- Each tab hosts its own UserControl (see Views folder); OptionsWindow.xaml.cs calls each
                 tab's Initialize()/SyncToSettings() to load/save its portion of ConfigurationSettings. -->
            <TabItem Header="FOLDER ORDER">
                <views:FolderOrderTabControl x:Name="FolderOrderTab"/>
            </TabItem>

            <TabItem Header="PREVIEWS ORDER">
                <views:PreviewsOrderTabControl x:Name="PreviewsOrderTab"/>
            </TabItem>

            <TabItem Header="MAME.ini">
                <views:MAMEiniTabControl x:Name="MameIniTab"/>
            </TabItem>

            <TabItem Header="MAME KEYBINDS">
                <views:MameKeybindsTabControl x:Name="MameKeybindsTab"/>
            </TabItem>

            <TabItem Header="SYSTEM PATHS">
                <views:SystemPathsTabControl x:Name="SystemPathsTab"/>
            </TabItem>

            <TabItem Header="ASSET PATHS">
                <views:AssetPathsTabControl x:Name="AssetPathsTab"/>
            </TabItem>

            <TabItem Header="INPUTS">
                <views:InputsTabControl x:Name="InputsTab"/>
            </TabItem>

            <TabItem Header="SCRAPER">
                <views:ScraperTabControl x:Name="ScraperTab"/>
            </TabItem>   

            <TabItem Header="ABOUT">
                <views:AboutTabControl x:Name="AboutTab"/>
            </TabItem>
            <!-- [END SECTION: Tab Pages] -->
        </TabControl>

        <!-- [SECTION: Save / Close Button Row] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save Adjustments" x:Name="BtnSaveOptions" Click="BtnSaveOptions_Click" 
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="Bold" Padding="15,6" Margin="0,0,10,0"/>
            <Button Content="Close Panel" x:Name="BtnCloseOptions" Click="BtnCloseOptions_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Padding="15,6"/>
        </StackPanel>
        <!-- [END SECTION: Save / Close Button Row] -->
    </Grid>
</Window>