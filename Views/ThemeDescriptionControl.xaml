<UserControl x:Class="ArcadeStick.Views.ThemeDescriptionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer x:Name="ScrollValue" VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
            <TextBlock x:Name="TxtValue" TextWrapping="Wrap"
                       Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
        </ScrollViewer>

        <DockPanel x:Name="PnlEdit" Visibility="Collapsed">
            <Button DockPanel.Dock="Bottom" Content="Apply" Click="BtnApply_Click" HorizontalAlignment="Left" Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="SemiBold" Padding="10,3" Margin="0,6,0,0"/>
            <TextBox x:Name="TxtEdit" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Style="{StaticResource GLTextBoxStyle}" Loaded="TxtEdit_Loaded"/>
        </DockPanel>
    </Grid>
</UserControl>
