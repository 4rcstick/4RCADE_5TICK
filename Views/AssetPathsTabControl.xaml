<UserControl x:Class="ArcadeStick.Views.AssetPathsTabControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick.Views"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="ASSET PATHS" 
                       FontWeight="Bold" Margin="0,0,0,8"
                       FontSize="{DynamicResource Global.Font.Header.Size}"
                       Foreground="{DynamicResource Global.Font.Header.Color}"/>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                       FontSize="{DynamicResource Global.Font.Standard.Size}"
                       Foreground="{DynamicResource Global.Font.Standard.Color}"
                       Text="The default folders for media assets are stored in the MAME root media subfolder, but you can change their directory paths here if yours are stored elsewhere."/>

            <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,5,0,15"/>

            <!-- [SECTION: Asset Path Rows] -->
            <!-- Repeating pattern: a path TextBox + a "..." browse Button, all wired to the same
                 BtnBrowseDirectory_Click handler in code-behind (which resolves the target TextBox from the sender). -->

            <!-- Marquees -->
            <TextBlock Text="Marquees Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtMarqueesPath" Text=".\data\media\marquees" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseMarquees" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- Videos -->
            <TextBlock Text="Videos Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtVideosPath" Text=".\data\media\videos" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseVideos" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- Flyers -->
            <TextBlock Text="Flyers Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtFlyersPath" Text=".\data\media\flyers" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseFlyers" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- Gameplay Captures -->
            <TextBlock Text="Gameplay Captures Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtGameplayPath" Text=".\data\media\gameplay" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseGameplay" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- Title Screens -->
            <TextBlock Text="Title Screens Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtTitlescreensPath" Text=".\data\media\titlescreens" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseTitlescreens" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- Cabinets -->
            <TextBlock Text="Cabinets Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtCabinetsPath" Text=".\data\media\cabinets" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseCabinets" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>
            <!-- [END SECTION: Asset Path Rows] -->

        </StackPanel>
    </ScrollViewer>
</UserControl>