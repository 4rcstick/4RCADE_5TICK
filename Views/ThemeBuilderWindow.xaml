<Window x:Class="ArcadeStick.Views.ThemeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        xmlns:views="clr-namespace:ArcadeStick.Views"
        Title="4RCADE 5TICK Theme Builder" Height="885" Width="717"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Global.Options.Bg}"
        BorderBrush="{StaticResource ChromeBorder}"
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab chrome (strip, header states, framed content area) comes from ThemedTabControlStyle in App.xaml. -->
        <TabControl x:Name="ThemeBuilderTabControl" Grid.Row="0"
                    Style="{StaticResource ThemedTabControlStyle}">

            <!-- [SECTION: Tab Pages] -->
            <!-- THEME BUILDER: the Themes Manager row (load, save, delete) on top, then the layer list and
                 per-layer property tabs. Code-behind compares the selected tab's Content to ThemeBuilderPage.
                 THEME BROWSER: empty placeholder reserved for the theme browser.
                 GLOBAL: the theme-wide values (not per resolution). -->

            <TabItem Header="THEME BUILDER">
                <Grid x:Name="ThemeBuilderPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <views:ThemesManagerControl x:Name="ThemesManager" Grid.Row="0" Margin="0,0,0,5"/>
                    <Separator Grid.Row="1" Background="{DynamicResource Global.Options.Separator}" Margin="15,10,15,0"/>
                    <views:AdvancedThemesTabControl x:Name="AdvancedTab" Grid.Row="2"/>
                </Grid>
            </TabItem>

            <TabItem Header="THEME BROWSER">
                <!-- Reserved for the theme browser control, which will replace this Grid -->
                <Grid x:Name="ThemeBrowserTab"/>
            </TabItem>

            <TabItem Header="GLOBAL">
                <views:GlobalThemesTabControl x:Name="GlobalTab"/>
            </TabItem>
            <!-- [END SECTION: Tab Pages] -->
        </TabControl>

        <!-- [SECTION: Save / Close Button Row] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save Adjustments" x:Name="BtnSaveAdjustments" Click="BtnSaveAdjustments_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="Bold" Padding="15,6" Margin="0,0,10,0"/>
            <Button Content="Close Panel" x:Name="BtnClosePanel" Click="BtnClosePanel_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Padding="15,6"/>
        </StackPanel>
        <!-- [END SECTION: Save / Close Button Row] -->
    </Grid>
</Window>