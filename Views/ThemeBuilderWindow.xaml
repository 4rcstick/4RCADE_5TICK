<Window x:Class="ArcadeStick.Views.ThemeBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        xmlns:views="clr-namespace:ArcadeStick.Views"
        Title="4RCADE 5TICK Theme Builder" Height="885" Width="693"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Global.Options.Bg}"
        BorderBrush="{StaticResource ChromeBorder}"
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tab chrome (strip, header states, framed content area) comes from ThemedTabControlStyle in App.xaml. -->
        <TabControl x:Name="ThemeBuilderTabControl" Grid.Row="0"
                    Style="{StaticResource ThemedTabControlStyle}">

            <!-- [SECTION: Tab Pages] -->
            <!-- Basic Themes hosts the Themes tab moved over from OptionsWindow, content unchanged.
                 Advanced Themes hosts the layer list and per-layer property tabs.
                 Global hosts the theme-wide values (not per resolution): Fonts and Backgrounds so far.
                 A Theme Browser tab will be added down the road. -->
            <TabItem Header="BASIC THEMES">
                <views:ThemesTabControl x:Name="ThemesTab"/>
            </TabItem>

            <TabItem Header="ADVANCED THEMES">
                <views:AdvancedThemesTabControl x:Name="AdvancedTab"/>
            </TabItem>

            <TabItem Header="GLOBAL">
                <views:GlobalThemesTabControl x:Name="GlobalTab"/>
            </TabItem>
            <!-- [END SECTION: Tab Pages] -->
        </TabControl>

        <!-- [SECTION: Save / Close Button Row] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save Adjustments" x:Name="BtnSaveAdjustments" Click="BtnSaveAdjustments_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="Bold" Padding="15,6" Margin="0,0,10,0"/>
            <Button Content="Close Panel" x:Name="BtnClosePanel" Click="BtnClosePanel_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Padding="15,6"/>
        </StackPanel>
        <!-- [END SECTION: Save / Close Button Row] -->
    </Grid>
</Window>