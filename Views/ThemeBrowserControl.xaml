<UserControl x:Class="ArcadeStick.Views.ThemeBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [SECTION: Bare Catalog List] -->
    <!-- The THEME BROWSER tab: a deliberately bare, scrollable list of the installed themes (ThemeCatalogReader), built in
         code-behind. The real layout and styling come in handoff 5. -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TEMPORARY diagnostics line (shown, read, from cache, skipped, hidden counts); removed in handoff 5 -->
        <TextBlock x:Name="TxtDiagnostics" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>

        <!-- Pixel scrolling (not the item-scrolling Themed variant), following the Global scrollbar values -->
        <ScrollViewer x:Name="ScrollEntries" Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewer}">
            <StackPanel x:Name="PnlEntries"/>
        </ScrollViewer>
    </Grid>
    <!-- [END SECTION: Bare Catalog List] -->
</UserControl>
