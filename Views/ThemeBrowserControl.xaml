<UserControl x:Class="ArcadeStick.Views.ThemeBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ArcadeStick.Services">
    <!-- [SECTION: Theme Browser Layout] -->
    <!-- The Theme Browser window's content: a stationary instruction line and a 2 px divider under it, then the scrolling catalog of
         theme entries built in code-behind (ThemeBrowserControl.xaml.cs). Every color and size is a Global resource; the
         padding and the gaps around the divider come from the constants block in code-behind. The scroll region reaches out to
         ScrollbarClearance.BaselineGutter from the inside of the right and bottom borders (negative margins set in the
         constructor), and ScrollbarClearance adds the scrollbar's corner clearance. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Instruction line: the Builder's instructional text look (Global Standard, as the Themes Manager intro). Stays put
             while the list scrolls. -->
        <TextBlock x:Name="TxtInstruction" Grid.Row="0" TextWrapping="Wrap"
                   Text="Select a resolution to load a theme, and click a thumbnail to enlarge the preview."
                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>

        <!-- Header divider: stationary (outside the ScrollViewer), Global divider color, fixed 2 px height. -->
        <Border x:Name="BrdHeaderDivider" Grid.Row="1" Height="2" SnapsToDevicePixels="True"
                Background="{DynamicResource Global.Options.Separator}"/>

        <!-- Pixel scrolling (not the item-scrolling Themed variant), following the Global scrollbar values. The shared size
             scope lets every entry's thumbnail column take the same width, so the text column starts at one x. -->
        <ScrollViewer x:Name="ScrollEntries" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ArcadeDarkScrollViewer}" services:ScrollbarClearance.Enabled="True">
            <StackPanel x:Name="PnlEntries" Grid.IsSharedSizeScope="True"/>
        </ScrollViewer>
    </Grid>
    <!-- [END SECTION: Theme Browser Layout] -->
</UserControl>
