<Window x:Class="ArcadeStick.Views.ManagePlayListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d"
        Title="Manage Custom Folders" 
        Height="400" 
        Width="500" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E24"
        BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}"
        BorderThickness="1"
        Foreground="White">

    <!-- This window handles both creating a new custom folder (playlist) and editing/deleting an
         existing one - which mode is active is driven by FolderComboBox selection in code-behind. -->
    <Window.Resources>
        <!-- [SECTION: Custom ComboBoxItem Style] -->
        <!-- Themed dropdown item style used by FolderComboBox below -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2D2D35}"/>
            <Setter Property="Foreground" Value="{Binding DataContext.StandardColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                <Setter Property="Foreground" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                <Setter Property="Foreground" Value="{Binding DataContext.TabActiveColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#000000}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- [END SECTION: Custom ComboBoxItem Style] -->

        <!-- [SECTION: Standard Button Style] -->
        <!-- Shared button style for this window's action buttons (Confirm/Cancel/Delete/Remove) -->
        <Style x:Key="StandardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding BtnBgColorHex, FallbackValue=#2D2D35}"/>
            <Setter Property="Foreground" Value="{Binding BtnTextColorNormalHex, FallbackValue=White}"/>
            <Setter Property="BorderBrush" Value="{Binding BtnBorderColorHex, FallbackValue=Transparent}"/>
            <Setter Property="BorderThickness" Value="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
            <Setter Property="FontSize" Value="{Binding OptionsBtnFontSize, FallbackValue=13}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{Binding OptionsBtnBorderRadius, FallbackValue=0}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{Binding BtnBgColorHoverHex, FallbackValue=#3A3A42}"/>
                                <Setter Property="Foreground" Value="{Binding OptionsBtnColorHoverHex, FallbackValue=White}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- [END SECTION: Standard Button Style] -->

        <!-- [SECTION: Confirm Button Style] -->
        <!-- Cyan "confirm" scheme layered on top of StandardButtonStyle's shared template/triggers -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="Background" Value="{Binding BtnBgColorHex, FallbackValue=#1E1E24}"/>
            <Setter Property="BorderBrush" Value="{Binding BtnBorderColorHex, FallbackValue=#00CBCB}"/>
            <Setter Property="Foreground" Value="{Binding BtnTextColorNormalHex, FallbackValue=#00CBCB}"/>
        </Style>
        <!-- [END SECTION: Confirm Button Style] -->

        <!-- [SECTION: Danger Button Style] -->
        <!-- Shared red "destructive action" scheme for Remove/Delete, layered on StandardButtonStyle -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonStyle}">
            <Setter Property="Foreground" Value="{Binding BtnTextColorNormalHex, FallbackValue=#CC1111}"/>
        </Style>
        <!-- [END SECTION: Danger Button Style] -->
    </Window.Resources>

    <Border Margin="20" 
            BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}" 
            BorderThickness="1" 
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- [SECTION: Folder Picker ComboBox] -->
            <!-- Custom-templated dropdown: "Create New Folder..." plus existing custom folders.
                 Selection here drives whether the window is in create-new vs edit-existing mode. -->
            <ComboBox x:Name="FolderComboBox" 
                  Grid.Row="0" 
                  Height="35" 
                  Margin="0,0,0,20"
                  Background="{Binding BtnBgColorHex, FallbackValue=#2D2D35}" 
                  Foreground="{Binding BtnTextColorNormalHex, FallbackValue=White}">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                      Focusable="false"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                      ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                            Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2D2D35}" 
                                            BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}" 
                                            BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" 
                                                  Grid.Column="1" 
                                                  Fill="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center" 
                                                  Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" 
                                          IsHitTestVisible="False" 
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,30,0" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" 
                               Placement="Bottom" 
                               IsOpen="{TemplateBinding IsDropDownOpen}" 
                               AllowsTransparency="True" 
                               Focusable="False" 
                               PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                  SnapsToDevicePixels="True" 
                                  MinWidth="{TemplateBinding ActualWidth}" 
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                        Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2D2D35}" 
                                        BorderThickness="1" 
                                        BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}" />
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
            </ComboBox>
            <!-- [END SECTION: Folder Picker ComboBox] -->

            <!-- [SECTION: Folder Name Input] -->
            <!-- Only relevant/visible when creating a new folder - hidden when editing an existing one -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="Folder Name:" 
                       Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" 
                       FontSize="{Binding HeaderFontSize, FallbackValue=14}" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"
                       Visibility="{Binding Visibility, ElementName=FolderNameTextBox}"/>
                <TextBox x:Name="FolderNameTextBox" 
                     Height="35" 
                     Background="Black" 
                     Foreground="White" 
                     VerticalContentAlignment="Center"
                     Padding="5,0"/>
            </StackPanel>
            <!-- [END SECTION: Folder Name Input] -->

            <!-- [SECTION: Hex Color + Remove Row] -->
            <!-- Optional #hexcolor override for the folder tag, plus a button to remove the currently
                 selected game from the active custom folder (edit mode only) -->
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15">
                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="35" Height="35" Cursor="Hand" BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}" BorderThickness="1" Margin="0">
                        <colorpicker:PortableColorPicker x:Name="PlaylistColorPicker" Width="35" Height="35" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="PlaylistColorPicker_ColorChanged"/>
                    </Border>
                    <TextBox Grid.Column="2" x:Name="HexColorTextBox" 
                         Height="35" 
                         Background="#2D2D35" 
                         Foreground="White" 
                         VerticalContentAlignment="Center"
                         Margin="5,0,0,0"/>
                </Grid>
                <Button x:Name="RemoveButton" 
                    Style="{StaticResource DangerButtonStyle}"
                    Content="Remove From Custom Folder" 
                    Height="35" 
                    Margin="10,0,0,0" 
                    FontWeight="Bold"/>
            </UniformGrid>
            <!-- [END SECTION: Hex Color + Remove Row] -->

            <!-- Deletes the entire selected custom folder (edit mode only) -->
            <Button x:Name="DeleteFolderButton" 
                Grid.Row="3" 
                Style="{StaticResource DangerButtonStyle}"
                Content="Delete Entire Folder" 
                Height="35" 
                Margin="0,0,0,20"/>

            <!-- [SECTION: Confirm / Cancel Row] -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ConfirmButton" 
                    Grid.Column="0" 
                    Style="{StaticResource ConfirmButtonStyle}"
                    Content="Confirm Add" 
                    Height="35"/>

                <Button x:Name="CancelButton" 
                    Grid.Column="2" 
                    Style="{StaticResource StandardButtonStyle}"
                    Content="Cancel" 
                    Height="35"/>
            </Grid>
        </Grid>
        <!-- [END SECTION: Confirm / Cancel Row] -->
    </Border>
</Window>