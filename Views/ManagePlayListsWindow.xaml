<Window x:Class="ArcadeStick.Views.ManagePlayListsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        mc:Ignorable="d"
        Title="Manage Custom Folders" 
        Height="400" 
        Width="500" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource ChromeWindowBg}"
        BorderBrush="{StaticResource ChromeBorder}"
        BorderThickness="1"
        Foreground="{StaticResource ChromeText}">

    <!-- This window handles both creating a new custom folder (playlist) and editing/deleting an
         existing one - which mode is active is driven by FolderComboBox selection in code-behind.
         Its buttons use the shared ThemedActionButtonStyle (Global Buttons resources). -->
    <Border Margin="20" 
            BorderBrush="{StaticResource ChromeBorder}" 
            BorderThickness="1" 
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- [SECTION: Folder Picker ComboBox] -->
            <!-- Chrome Palette dropdown: "Create New Folder..." plus existing custom folders.
                 Selection here drives whether the window is in create-new vs edit-existing mode. -->
            <ComboBox x:Name="FolderComboBox" 
                  Grid.Row="0" 
                  Height="35" 
                  Margin="0,0,0,20"
                  Style="{StaticResource ChromeComboBoxStyle}"/>
            <!-- [END SECTION: Folder Picker ComboBox] -->

            <!-- [SECTION: Folder Name Input] -->
            <!-- Only relevant/visible when creating a new folder - hidden when editing an existing one -->
            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="Folder Name:" 
                       Foreground="{DynamicResource Global.Font.Header.Color}" 
                       FontSize="{DynamicResource Global.Font.Header.Size}" 
                       FontWeight="Bold" 
                       Margin="0,0,0,5"
                       Visibility="{Binding Visibility, ElementName=FolderNameTextBox}"/>
                <TextBox x:Name="FolderNameTextBox" 
                     Height="35" 
                     Style="{StaticResource ChromeTextBoxStyle}" 
                     VerticalContentAlignment="Center"
                     Padding="5,0"/>
            </StackPanel>
            <!-- [END SECTION: Folder Name Input] -->

            <!-- [SECTION: Hex Color + Remove Row] -->
            <!-- Optional #hexcolor override for the folder tag, plus a button to remove the currently
                 selected game from the active custom folder (edit mode only) -->
            <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,15">
                <Grid Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="35" Height="35" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1" Margin="0">
                        <colorpicker:PortableColorPicker x:Name="PlaylistColorPicker" Width="35" Height="35" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="PlaylistColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox Grid.Column="2" x:Name="HexColorTextBox" 
                         Height="35" 
                         Style="{StaticResource ChromeTextBoxStyle}" 
                         VerticalContentAlignment="Center"
                         Margin="5,0,0,0"/>
                </Grid>
                <Button x:Name="RemoveButton" 
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="Remove From Custom Folder" 
                    Height="35" 
                    Margin="10,0,0,0" 
                    FontWeight="Bold"/>
            </UniformGrid>
            <!-- [END SECTION: Hex Color + Remove Row] -->

            <!-- Deletes the entire selected custom folder (edit mode only) -->
            <Button x:Name="DeleteFolderButton" 
                Grid.Row="3" 
                Style="{StaticResource ThemedActionButtonStyle}"
                Content="Delete Entire Folder" 
                Height="35" 
                Margin="0,0,0,20"/>

            <!-- [SECTION: Confirm / Cancel Row] -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="ConfirmButton" 
                    Grid.Column="0" 
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="Confirm Add" 
                    Height="35"/>

                <Button x:Name="CancelButton" 
                    Grid.Column="2" 
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Content="Cancel" 
                    Height="35"/>
            </Grid>
        </Grid>
        <!-- [END SECTION: Confirm / Cancel Row] -->
    </Border>
</Window>