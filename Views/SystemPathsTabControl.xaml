<UserControl x:Class="ArcadeStick.Views.SystemPathsTabControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick.Views"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="SYSTEM PATHS" 
                       FontWeight="Bold" Margin="0,0,0,8"
                       FontSize="{DynamicResource Global.Font.Header.Size}"
                       Foreground="{DynamicResource Global.Font.Header.Color}"/>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                       FontSize="{DynamicResource Global.Font.Standard.Size}"
                       Foreground="{DynamicResource Global.Font.Standard.Color}">

            <Run Text="Set the directory paths for your ROMs, BIOS, and CHD folders. These folders do not need to be in the MAME root directory and can even be located on separate drives."/>
            <LineBreak/>
            <LineBreak/>
            <Run Text="After changing any of these paths, click the Rescan Folders button below and your new paths will be saved to mame.ini and the Games List will be refreshed to reflect the changes made."/>
            <LineBreak/>
            <LineBreak/>
            <Run Text="*It is highly recommended, if the ROMs directory is on a separate drive, to avoid deeply nesting it in multiple subfolders — this is due to a limitation in how MAME reads long rompath entries from mame.ini. If your rompath is too long, you'll be notified with an alert so you can address it. In most cases, this will not be an issue." />
            </TextBlock>

            <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,5,0,15"/>

            <!-- [SECTION: System Path Rows] -->
            <!-- Same TextBox + "..." browse Button pattern as Asset Paths, routed through
                 BtnBrowseDirectory_Click. NOTE: unlike Asset Paths, these require a restart to take
                 effect (see intro text above) since ROM/BIOS/CHD paths feed the boot-time scan. -->

            <!-- ROMs -->
            <TextBlock Text="ROMs Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtRomsPath" Text=".\Data\roms" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseRoms" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- BIOS -->
            <TextBlock Text="BIOS Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtBiosPath" Text=".\Data\bios" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseBios" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>

            <!-- CHD -->
            <TextBlock Text="CHD Folder:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtChdPath" Text="" Style="{StaticResource ChromeTextBoxStyle}" Padding="4"/>
                <Button Grid.Column="1" x:Name="BtnBrowseChd" Click="BtnBrowseDirectory_Click" Content="..." 
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Margin="5,0,0,0"/>
            </Grid>
            <!-- [END SECTION: System Path Rows] -->

            <!-- [SECTION: Live Rescan Button] -->
            <!-- Rewrites mame.ini's rompath (ROMs subfolders + CHD path) and rebuilds the game list
                 live, without requiring an app restart. -->
            <Button x:Name="BtnRescanRomPaths" Click="BtnRescanRomPaths_Click" Content="Rescan Folders"
                    HorizontalAlignment="Left" Padding="10,5"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Margin="0,5,0,0"/>
            <!-- [END SECTION: Live Rescan Button] -->
        </StackPanel>
    </ScrollViewer>
</UserControl>