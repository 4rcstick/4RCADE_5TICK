                            <Button Grid.Column="2" x:Name="BtnClearP1JoyDown" Content="Clear" Margin="10,0" Click="BtnClearP1JoyDown_Click" Padding="6,3" HorizontalAlignment="Left" Style="{StaticResource ThemedActionButtonStyle}" Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}" Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}" BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}" BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
                            <TextBlock Grid.Column="3" x:Name="TxtP1JoyDownSummary" Text="—" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
