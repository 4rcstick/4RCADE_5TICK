                            <TextBlock Grid.Column="3" x:Name="TxtP1JoyLeftSummary" Text="—" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
