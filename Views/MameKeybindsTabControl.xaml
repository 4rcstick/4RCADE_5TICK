<UserControl x:Class="ArcadeStick.Views.MameKeybindsTabControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick.Views"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5,5,5" Style="{StaticResource ArcadeDarkScrollViewer}">
        <StackPanel Margin="15">

            <TextBlock Text="DEFAULT MAME KEYBINDS" 
           FontWeight="Bold" Margin="0,0,0,8"
           FontSize="{Binding HeaderFontSize, FallbackValue=14}"
           Foreground="{Binding HeaderColorHex, FallbackValue=#FFef44c3}"/>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
           FontSize="{Binding StandardFontSize, FallbackValue=13}"
           Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}"
           Text="Binding any inputs here will save them to MAME's default.cfg file and will 
apply to any game that does not have custom bindings in their respective gamename.cfg file. Click on 'Bind' and then any input (keyboard, mouse or controller) to bind it. Each row can have multiple inputs bound to it. Click 'Clear' to remove all binds in the row and start over."/>

            <Border Padding="5">
                <StackPanel>
                    <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,10"/>
                    <TextBlock Text="DIGITAL STICK 1" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" Margin="0,0,0,5"/>

                    <!-- Stick 1 Up -->
                    <StackPanel Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="107"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Stick 1 Up:" Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}" VerticalAlignment="Center" HorizontalAlignment="Right"  Margin="10,0,10,0"/>
                            <Button Grid.Column="1" x:Name="BtnCaptureP1JoyUp" Content="Bind" Click="BtnCaptureP1JoyUp_Click" Padding="6,3" HorizontalAlignment="Left" Style="{StaticResource ThemedActionButtonStyle}" Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}" Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}" BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}" BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
                            <Button Grid.Column="2" x:Name="BtnClearP1JoyUp" Content="Clear" Margin="10,0" Click="BtnClearP1JoyUp_Click" Padding="6,3" HorizontalAlignment="Left" Style="{StaticResource ThemedActionButtonStyle}" Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}" Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}" BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}" BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
                            <TextBlock Grid.Column="3" x:Name="TxtP1JoyUpSummary" Text="—" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>

                    <!-- Stick 1 Down -->
                    <StackPanel Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="107"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
