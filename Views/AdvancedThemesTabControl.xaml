                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtPlayButtonBoxShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtPlayButtonBoxShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtPlayButtonBoxShadowBlur" Grid.Row="5" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkPlayButtonBoxShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="PlayButtonField_LostFocus" KeyDown="PlayButtonField_KeyDown"/>
                                    <TextBox x:Name="TxtPlayButtonBoxShadowDepth" Grid.Row="5" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkPlayButtonBoxShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="PlayButtonField_LostFocus" KeyDown="PlayButtonField_KeyDown"/>
                                </Grid>

                                <!-- Border: color, size (0 to 50), radius (0 to 200) -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Border" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Size:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Radius:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="PlayButtonBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="PlayButtonBorderColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtPlayButtonBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtPlayButtonBorderColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtPlayButtonBorderSize" Grid.Row="2" Grid.Column="2" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="PlayButtonField_LostFocus" KeyDown="PlayButtonField_KeyDown"/>
                                    <TextBox x:Name="TxtPlayButtonCornerRadius" Grid.Row="2" Grid.Column="4" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="PlayButtonField_LostFocus" KeyDown="PlayButtonField_KeyDown"/>
                                </Grid>

                                <!-- Hover: text, fill and border colors while the mouse is over the button -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Hover" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Text color:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="PlayButtonHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="PlayButtonHoverColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtPlayButtonHoverColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtPlayButtonHoverColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Text="Background:" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="PlayButtonHoverBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="PlayButtonHoverBgColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtPlayButtonHoverBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtPlayButtonHoverBgColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Text="Border color:" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="PlayButtonHoverBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="PlayButtonHoverBorderColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtPlayButtonHoverBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtPlayButtonHoverBorderColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Game Info - Play Button Tab] -->

                    <!-- [SECTION: Game Info - Favorites Star Tab] -->
                    <!-- The star that adds or removes the selected game from Favorites, stored on the FavoritesStar entry. Size and the
                         solid star use the GI block system (block "FavStar", Text* fields); the outline star has its own controls (Outline* fields). -->
                    <TabItem x:Name="TabGIFavStar" Header="FAVORITES STAR" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <!-- Size (shared by both states) and the glow tip -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Size:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox x:Name="GIFavStarSize" Tag="FavStar" Grid.Row="1" Grid.Column="0" Width="48" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="A glow is a shadow with Depth 0 and a bright color." TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>
                                </Grid>

                                <!-- Solid star: color and drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Solid star (game is in Favorites)" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Color:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GIFavStarColorPicker" Tag="FavStar" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GIFavStarColorHex" Tag="FavStar" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIColorHex_LostFocus"/>
                                    </StackPanel>
                                    <CheckBox x:Name="GIFavStarShadow" Tag="FavStar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="GIShadow_Click"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="5" Grid.Column="0" IsEnabled="{Binding IsChecked, ElementName=GIFavStarShadow}" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GIFavStarShadowColorPicker" Tag="FavStar" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GIFavStarShadowColorHex" Tag="FavStar" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="GIFavStarShadowBlur" Tag="FavStar" Grid.Row="5" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIFavStarShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBox x:Name="GIFavStarShadowDepth" Tag="FavStar" Grid.Row="5" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIFavStarShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                </Grid>

                                <!-- Outline star: color and drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Outline star (game is not in Favorites)" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Color:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="FavStarOutlineColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="FavStarOutlineColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtFavStarOutlineColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtFavStarOutlineColorHex_LostFocus"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkFavStarOutlineShadow" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="ChkFavStarOutlineShadow_Click"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="5" Grid.Column="0" IsEnabled="{Binding IsChecked, ElementName=ChkFavStarOutlineShadow}" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="FavStarOutlineShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="FavStarOutlineShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtFavStarOutlineShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtFavStarOutlineShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtFavStarOutlineShadowBlur" Grid.Row="5" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkFavStarOutlineShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="FavStarField_LostFocus" KeyDown="FavStarField_KeyDown"/>
                                    <TextBox x:Name="TxtFavStarOutlineShadowDepth" Grid.Row="5" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkFavStarOutlineShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="FavStarField_LostFocus" KeyDown="FavStarField_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Game Info - Favorites Star Tab] -->

                    <!-- [SECTION: Shape Layer - Background Tab] -->
                    <TabItem x:Name="TabShapeBackground" Header="BACKGROUND" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Image / video file (png, jpg, gif, mp4):" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtShapeFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseShapeFile" Content="Browse" Click="BtnBrowseShapeFile_Click"
                                            Style="{StaticResource ThemedActionButtonStyle}"
                                            FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearShapeFile" Content="Clear" Click="BtnClearShapeFile_Click"
                                            Style="{StaticResource ThemedActionButtonStyle}"
                                            FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Image / video opacity (0 to 100):" Style="{StaticResource GLLabelStyle}" Margin="0,16,0,3"/>
                                <TextBox x:Name="TxtShapeOpacity" Width="52" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeOpacityField_LostFocus" KeyDown="ShapeOpacityField_KeyDown"/>

                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,16,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="ShapeBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ShapeBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtShapeBgColorHex" Width="100" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtShapeBgColorHex_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Shape Layer - Background Tab] -->

                    <!-- [SECTION: Splash Image - Image Tab] -->
                    <!-- The splash file shown while no game is selected, stored in the Splash Image entry's ImagePath
                         (empty = the built-in splash). Sits before the Border tab so the order is Position, Image, Border. -->
                    <TabItem x:Name="TabSplashImage" Header="IMAGE" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Splash image or video (png, jpg, gif, mp4), shown when no game is selected:" TextWrapping="Wrap" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSplashFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseSplashFile" Content="Browse" Click="BtnBrowseSplashFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearSplashFile" Content="Clear" Click="BtnClearSplashFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in splash." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Splash Image - Image Tab] -->

                    <!-- [SECTION: Random Game Display - Text Tab] -->
                    <!-- The spin card's message and text style, shared by both states and stored on the RandomGameDisplay
                         entry; the max text size is per state (each part's own TextFontSize). Empty message = no text. -->
                    <TabItem x:Name="TabRGText" Header="TEXT" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Message (max 60 characters; applies on Enter or focus loss) -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Message (leave empty for no text):" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtRGMessage" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" MaxLength="60"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtRGMessage_LostFocus" KeyDown="TxtRGMessage_KeyDown"/>

                                <!-- Font family + bold -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="Font:" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <ComboBox x:Name="CboRGFont" Width="160" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboRGFont_SelectionChanged"/>
                                    <CheckBox x:Name="ChkRGBold" Content="Bold" Margin="12,0,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkRGBold_Click"/>
                                </StackPanel>

                                <!-- Color, then alignment -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Color:" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Text="Alignment:" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="RGTextColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="RGTextColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                    <TextBox x:Name="TxtRGTextColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtRGTextColorHex_LostFocus"/>
                                </StackPanel>
                                <ComboBox x:Name="CboRGAlign" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" Width="110" Height="25" HorizontalAlignment="Left"
                                          Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboRGAlign_SelectionChanged"/>

                                <!-- Wrap at the box width (shared by both states) -->
                                <CheckBox x:Name="ChkRGWrap" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Content="Wrap text" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkRGWrap_Click"/>

                                <!-- Max text size per state (6 to 200): the text shrinks below it only when it does not fit -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Text="Max text size (px):" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                <!-- One state per row, label above its box, on the tab's column grid -->
                                <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="When a game is selected:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtRGFontSize" Grid.Row="1" Grid.Column="0" Width="52" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="RGField_LostFocus" KeyDown="RGField_KeyDown"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Text="When on the splash page:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBox x:Name="TxtRGSplashFontSize" Grid.Row="3" Grid.Column="0" Width="52" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="RGField_LostFocus" KeyDown="RGField_KeyDown"/>
                                </Grid>

                                <!-- Drop shadow -->
                                <CheckBox x:Name="ChkRGShadow" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,12,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkRGShadow_Click"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="11" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkRGShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="RGShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="RGShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                    <TextBox x:Name="TxtRGShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtRGShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtRGShadowBlur" Grid.Row="11" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkRGShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="RGField_LostFocus" KeyDown="RGField_KeyDown"/>
                                <TextBox x:Name="TxtRGShadowDepth" Grid.Row="11" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkRGShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="RGField_LostFocus" KeyDown="RGField_KeyDown"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Random Game Display - Text Tab] -->

                    <!-- [SECTION: Random Game Display - Background Tab] -->
                    <!-- The file (shared by both states, RandomGameDisplay's ImagePath) drawn over the background color and
                         under the message, then the background color per state (each part's BgColorHex; its alpha decides how
                         much of the layers behind shows through), picked with the State combo. -->
                    <TabItem x:Name="TabRGBackground" Header="BACKGROUND" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Image or video (png, jpg, gif, mp4), drawn over the color and under the message:" TextWrapping="Wrap" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtRGFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseRGFile" Content="Browse" Click="BtnBrowseRGFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearRGFile" Content="Clear" Click="BtnClearRGFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Which state's background color the row below edits (session-only) -->
                                <StackPanel x:Name="PnlRGBgState" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="State:" Style="{StaticResource GLLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CboRGBgState" Width="200" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboRGState_SelectionChanged"/>
                                </StackPanel>
                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="RGBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="RGBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtRGBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtRGBgColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBlock Text="Lower the alpha to let the layers behind the card show through." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Random Game Display - Background Tab] -->

                    <!-- [SECTION: Shape Layer - Border Tab] -->
                    <TabItem x:Name="TabShapeBorder" Header="BORDER" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                            <!-- Random Game Display only: which state's border the fields below edit (session-only) -->
                            <StackPanel x:Name="PnlRGBorderState" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock Text="State:" Style="{StaticResource GLLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CboRGBorderState" Width="200" Height="25"
                                          Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboRGState_SelectionChanged"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Border color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Size:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Radius:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="ShapeBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ShapeBorderColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtShapeBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtShapeBorderColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtShapeBorderSize" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeBorderField_LostFocus" KeyDown="ShapeBorderField_KeyDown"/>
                                <TextBox x:Name="TxtShapeCornerRadius" Grid.Row="1" Grid.Column="4" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeBorderField_LostFocus" KeyDown="ShapeBorderField_KeyDown"/>

                                <!-- Hover border color: Search & Buttons only (the four buttons' border while the mouse is over them) -->
                                <StackPanel x:Name="PnlSBHoverBorder" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed">
                                    <TextBlock Text="Hover border color:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="SBHoverBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBHoverBorderColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtSBHoverBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBHoverBorderColorHex_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Shape Layer - Border Tab] -->

                    <!-- [SECTION: Video Preview - Background Tab] -->
                    <!-- The fill behind and around the video (the letterbox bars), stored in the Video Preview entry's
                         BgColorHex. Not the shape layers' TabShapeBackground. -->
                    <TabItem x:Name="TabVideoBackground" Header="BACKGROUND" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="VPBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="VPBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtVPBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtVPBgColorHex_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Video Preview - Background Tab] -->

                    <!-- [SECTION: Video Preview - Fallback Image Tab] -->
                    <!-- The "no preview available" image shown for a game with no media, stored in the Video Preview
                         entry's ImagePath (empty = the built-in no_preview.png). -->
                    <TabItem x:Name="TabVideoFallback" Header="FALLBACK IMAGE" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Image (png, jpg, bmp), shown when the selected game has no preview:" TextWrapping="Wrap" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtVPFallbackFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseVPFallback" Content="Browse" Click="BtnBrowseVPFallback_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearVPFallback" Content="Clear" Click="BtnClearVPFallback_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in image." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Video Preview - Fallback Image Tab] -->

                    <!-- [SECTION: Marquee - Logo Tab] -->
                    <TabItem x:Name="TabMarqueeLogo" Header="LOGO" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Logo image (png, jpg), shown when no game is selected:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtMarqueeLogoFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseMarqueeLogo" Content="Browse" Click="BtnBrowseMarqueeLogo_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearMarqueeLogo" Content="Clear" Click="BtnClearMarqueeLogo_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in logo." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Marquee - Logo Tab] -->

                    <!-- [SECTION: Marquee - Shadow Tab] -->
                    <TabItem x:Name="TabMarqueeShadow" Header="SHADOW" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <!-- Logo and marquee image shadow: drop shadow (a glow is a shadow with depth 0 and a bright color) -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Logo and marquee image shadow" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Text="Glow: set Depth to 0 and pick a bright color." TextWrapping="Wrap"
                                               Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>

                                    <!-- Drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                    <CheckBox x:Name="GIMarqueeShadow" Tag="Marquee" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="GIShadow_Click"/>
                                    <!-- Which images get the shadow: Both, Logo only, Marquees only (game marquee and spin frames) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Text="Apply shadow to:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5">
                                        <ComboBox x:Name="GIMarqueeShadowTarget" Tag="Marquee" Width="130" Height="25" HorizontalAlignment="Left"
                                                  IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}"
                                                  Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="GIShadowTarget_SelectionChanged"/>
                                        <TextBlock Text="Marquees includes the no-art title card." TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GIMarqueeShadowColorPicker" Tag="Marquee" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GIMarqueeShadowColorHex" Tag="Marquee" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="GIMarqueeShadowBlur" Tag="Marquee" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBox x:Name="GIMarqueeShadowDepth" Tag="Marquee" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Marquee - Shadow Tab] -->

                    <!-- [SECTION: Marquee - Banner Tab] -->
                    <!-- The no-art title card (the idle banner and the spin's no-marquee card share it), stored on the
                         MarqueePanel entry: font + bold; max size and color; wrap; background; the title's drop shadow
                         (BannerShadow*); the card's border. Preview banner is session-only. -->
                    <TabItem x:Name="TabMarqueeBanner" Header="BANNER" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Session-only: shows the banner on the main window without a game that has no marquee art -->
                                <CheckBox x:Name="ChkBannerPreview" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Content="Preview banner"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkBannerPreview_Click"/>

                                <!-- Font family + bold -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Font:" Style="{StaticResource GLLabelStyle}" Margin="0,10,0,3"/>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <ComboBox x:Name="CboBannerFont" Width="160" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboBannerFont_SelectionChanged"/>
                                    <CheckBox x:Name="ChkBannerBold" Content="Bold" Margin="12,0,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkBannerBold_Click"/>
                                </StackPanel>

                                <!-- Max size (6 to 200, inside the card's 400x100 reference box), then color -->
                                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Max size:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox x:Name="TxtBannerFontSize" Grid.Row="1" Grid.Column="0" Width="48" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="BannerField_LostFocus" KeyDown="BannerField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="BannerColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="BannerColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtBannerColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtBannerColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Wrap at the card's width (on: the block shrinks only when taller than the card), and the one-line
                                     title's left and right inset in reference box units (0 to 100; disabled in code while wrap is on) -->
                                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="ChkBannerWrap" Content="Wrap text" VerticalAlignment="Center"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="ChkBannerWrap_Click"/>
                                    <TextBlock Text="Text margin (units):" Style="{StaticResource GLLabelStyle}" Margin="24,0,6,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBannerTextMargin" Width="48" HorizontalContentAlignment="Center" ToolTip="One-line title only: the gap at each side of the card"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="BannerField_LostFocus" KeyDown="BannerField_KeyDown"/>
                                </StackPanel>

                                <!-- Background color (alpha shows the marquee panel behind the card) -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="5" Text="Background:" Style="{StaticResource GLLabelStyle}" Margin="0,8,0,3"/>
                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="BannerBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="BannerBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtBannerBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtBannerBgColorHex_LostFocus"/>
                                </StackPanel>

                                <!-- Title drop shadow (its own; the card's shadow is the Shadow tab's) -->
                                <CheckBox x:Name="ChkBannerShadow" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow (text)" Margin="0,12,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkBannerShadow_Click"/>
                                <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkBannerShadow}">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="BannerShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="BannerShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtBannerShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtBannerShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtBannerShadowBlur" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkBannerShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="BannerField_LostFocus" KeyDown="BannerField_KeyDown"/>
                                    <TextBox x:Name="TxtBannerShadowDepth" Grid.Row="1" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkBannerShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="BannerField_LostFocus" KeyDown="BannerField_KeyDown"/>
                                </Grid>

                                <!-- Card border: color, size (0 to 50), radius (0 to 200); never scales with the marquee box -->
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Border color:" Style="{StaticResource GLLabelStyle}" Margin="0,12,0,3"/>
                                <TextBlock Grid.Row="9" Grid.Column="2" Text="Size:" Style="{StaticResource GLLabelStyle}" Margin="0,12,0,3"/>
                                <TextBlock Grid.Row="9" Grid.Column="4" Text="Radius:" Style="{StaticResource GLLabelStyle}" Margin="0,12,0,3"/>
                                <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="BannerBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="BannerBorderColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtBannerBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtBannerBorderColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtBannerBorderSize" Grid.Row="10" Grid.Column="2" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="BannerField_LostFocus" KeyDown="BannerField_KeyDown"/>
                                <TextBox x:Name="TxtBannerCornerRadius" Grid.Row="10" Grid.Column="4" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="BannerField_LostFocus" KeyDown="BannerField_KeyDown"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Marquee - Banner Tab] -->

                    <!-- [SECTION: Main Window Background - Image Tab] -->
                    <!-- The Main Window Background layer (per resolution): the background color (BgColorHex), then the wallpaper,
                         an image or a looping mp4 stored in the entry's ImagePath, plus the Disable flag (solid background color
                         only). Same layout as the Logo tab, with a color row on top. -->
                    <TabItem x:Name="TabMainBgImage" Header="IMAGE" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <!-- Background color: fills the window under the wallpaper (and alone when it is disabled); also the
                                     app's popup and dialog background -->
                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="MainBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="MainBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtMainBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtMainBgColorHex_LostFocus"/>
                                </StackPanel>

                                <TextBlock Text="Background image or video (png, jpg, bmp, mp4):" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtMainBgFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseMainBgFile" Content="Browse" Click="BtnBrowseMainBgFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearMainBgFile" Content="Clear" Click="BtnClearMainBgFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in background image." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                                <CheckBox x:Name="ChkMainBgImageDisabled" Content="Disable background image (use the color only)"
                                          HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkMainBgImageDisabled_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Main Window Background - Image Tab] -->
                </TabControl>

                <!-- [SECTION: Multi-Select Nudge] -->
                <!-- Two or more rows selected: replaces the tab frame. The boxes are nudge amounts (not positions) that
                     move every selected layer together and return to 0 after each move (code-behind: LoadMultiSelection). -->
                <StackPanel Grid.Row="1" x:Name="PnlMultiSelect" Visibility="Collapsed" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Move X by (px):" Style="{StaticResource GLLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Move Y by (px):" Style="{StaticResource GLLabelStyle}"/>
                        <TextBox x:Name="TxtMultiX" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                 Style="{StaticResource GLTextBoxStyle}" LostFocus="MultiNudge_LostFocus" KeyDown="MultiNudge_KeyDown"/>
                        <TextBox x:Name="TxtMultiY" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Center"
                                 Style="{StaticResource GLTextBoxStyle}" LostFocus="MultiNudge_LostFocus" KeyDown="MultiNudge_KeyDown"/>
                    </Grid>
                    <TextBlock x:Name="TxtMultiHint" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>
                </StackPanel>
                <!-- [END SECTION: Multi-Select Nudge] -->

                <!-- Layer-wide buttons, pinned below the tab frame so they sit in the same place on every tab and layer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <!-- Rename: shape layers and custom layers only (shown from code) -->
                    <Button x:Name="BtnRenameLayer" Content="Rename" Click="BtnRenameLayer_Click" Visibility="Collapsed"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3"/>
                    <Button x:Name="BtnResetLayer" Content="Reset Layer" Click="BtnResetLayer_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnRemoveLayer" Content="Remove Layer" Click="BtnRemoveLayer_Click" Visibility="Collapsed"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <!-- [END SECTION: Layer Property Tabs] -->
        </Grid>
        <!-- [END SECTION: Layer List + Fields] -->
    </Grid>
</UserControl>
