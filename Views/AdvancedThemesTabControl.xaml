                                </StackPanel>
                                <TextBox x:Name="TxtShapeBorderSize" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeBorderField_LostFocus" KeyDown="ShapeBorderField_KeyDown"/>
                                <TextBox x:Name="TxtShapeCornerRadius" Grid.Row="1" Grid.Column="4" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeBorderField_LostFocus" KeyDown="ShapeBorderField_KeyDown"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Shape Layer - Border Tab] -->

                    <!-- [SECTION: Marquee - Logo Tab] -->
                    <TabItem x:Name="TabMarqueeLogo" Header="LOGO" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Logo image (png, jpg), shown when no game is selected:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtMarqueeLogoFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseMarqueeLogo" Content="Browse" Click="BtnBrowseMarqueeLogo_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                        BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearMarqueeLogo" Content="Clear" Click="BtnClearMarqueeLogo_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FFD60A}"
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FFD60A}"
                        BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in logo." Foreground="{Binding SubTextColorHex, FallbackValue=#A0A0A2}" FontSize="{Binding SubTextFontSize, FallbackValue=12}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Marquee - Logo Tab] -->
                </TabControl>

                <!-- Layer-wide buttons, pinned below the tab frame so they sit in the same place on every tab and layer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="BtnResetLayer" Content="Reset Layer" Click="BtnResetLayer_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FFD60A}"
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FFD60A}"
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3"/>
                    <Button x:Name="BtnRemoveLayer" Content="Remove Layer" Click="BtnRemoveLayer_Click" Visibility="Collapsed"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FF453A}"
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FF453A}"
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <!-- [END SECTION: Layer Property Tabs] -->
        </Grid>
        <!-- [END SECTION: Layer List + Fields] -->
    </Grid>
</UserControl>
