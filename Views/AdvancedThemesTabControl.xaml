<UserControl x:Class="ArcadeStick.Views.AdvancedThemesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="680">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [SECTION: Guide] -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ADVANCED THEMES" Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" FontWeight="Bold" FontSize="{Binding HeaderFontSize, FallbackValue=14}" Margin="0,0,0,10"/>
            <TextBlock Text="Choose a resolution, then select a layer to set its position, size and visibility. Layers higher in the list draw on top. Values apply when you press Enter or leave the field. Save Adjustments writes them to settings.json; Save Changes on the Basic Themes tab writes them into the theme file."
                       Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- [END SECTION: Guide] -->

        <!-- [SECTION: Resolution Row] -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">

            <!-- Theme sizes: one button per size saved in the theme file (filled from code-behind) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Theme sizes:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <WrapPanel x:Name="PnlSavedSizes" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom resolution entry: shown only after "Custom..." is picked in the combo box -->
            <StackPanel x:Name="PnlCustomRes" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock Text="Custom size:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtCustomWidth" Width="70" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" KeyDown="CustomRes_KeyDown"/>
                <TextBlock Text="x" Foreground="{Binding StandardColorHex, FallbackValue=White}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                <TextBox x:Name="TxtCustomHeight" Width="70" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" KeyDown="CustomRes_KeyDown"/>
                <Button x:Name="BtnAddCustomRes" Content="Apply" Click="BtnAddCustomRes_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                                                BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="10,3" Margin="10,0,0,0"/>
                <Button x:Name="BtnKeepCustomRes" Content="Keep" Click="BtnKeepCustomRes_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FFD60A}"
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FFD60A}"
                        BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="10,3" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="0" Text="Resolution:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <ComboBox Grid.Column="1" x:Name="CboResolution" Width="140" Height="25"
                      Foreground="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                      SelectionChanged="CboResolution_SelectionChanged">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                                BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"
                                                BorderThickness="1">
                                            <Path Fill="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,25,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                            BorderThickness="1"
                                            BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                        <Setter Property="Foreground" Value="{Binding DataContext.StandardColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                <Setter Property="Foreground" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <!-- Alignment guides: editor preferences (not saved in the theme). Handlers live in code-behind. -->
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="ChkShowGuides" Content="Show guides" Click="ChkShowGuides_Click" VerticalContentAlignment="Center" Margin="0,0,15,0"
                          Foreground="{Binding StandardColorHex, FallbackValue=White}" FontSize="{Binding StandardFontSize, FallbackValue=12}"/>
                <TextBlock Text="Guide color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}" BorderThickness="1">
                    <colorpicker:PortableColorPicker x:Name="GuideColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GuideColorPicker_ColorChanged">
                        <colorpicker:PortableColorPicker.Resources>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <Trigger Property="Name" Value="MainGrid">
                                        <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </colorpicker:PortableColorPicker.Resources>
                    </colorpicker:PortableColorPicker>
                </Border>
                <TextBox x:Name="TxtGuideColorHex" Width="100" Margin="5,0,0,0" Text="#FF00FFFF" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtGuideColorHex_LostFocus"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnResetLayout" Content="Reset Layout" Click="BtnResetLayout_Click" HorizontalAlignment="Left"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FF453A}"
                    BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FF453A}"
                    BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                <Button x:Name="BtnDeleteCustomRes" Content="Delete Size" Click="BtnDeleteCustomRes_Click" Visibility="Collapsed"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FF453A}"
                    BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FF453A}"
                    BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                <Button x:Name="BtnRestoreDefaults" Content="Restore Defaults" Click="BtnRestoreDefaults_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FFD60A}"
                    BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FFD60A}"
                    BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
            </StackPanel>
            </Grid>
        </StackPanel>
        <!-- [END SECTION: Resolution Row] -->

        <!-- [SECTION: Layer List + Fields] -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Layer list (frontmost at top) with up/down arrows beside it -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="LstLayers" Grid.Column="0" DisplayMemberPath="DisplayName" SelectionChanged="LstLayers_SelectionChanged"
                         Background="#1C1C1E" BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}" BorderThickness="1"
                         Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="8,4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.TabBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{Binding DataContext.FolderSelectedBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                                <Setter Property="Foreground" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#000000}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="BtnLayerUp" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Click="BtnLayerUp_Click" ToolTip="Bring forward" Width="30" Height="30" Margin="0,0,0,6"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
                    <Button x:Name="BtnLayerDown" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Click="BtnLayerDown_Click" ToolTip="Send backward" Width="30" Height="30" Margin="0,0,0,6"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
                    <Button x:Name="BtnAddImageLayer" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="BtnAddImageLayer_Click" ToolTip="Add image layer" Width="30" Height="30"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                            Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                            BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                            BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"/>
                </StackPanel>
            </Grid>

            <!-- Selected layer fields (scrolls, since a grouped layer shows every part at once) -->
            <ScrollViewer Grid.Column="2" x:Name="PnlLayerFields" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="TxtLayerName" Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" FontWeight="Bold" FontSize="{Binding HeaderFontSize, FallbackValue=14}" Margin="0,0,0,10"/>

                <StackPanel x:Name="PnlRectFields">
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="X:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                        <TextBlock Grid.Column="2" Text="Y:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtLayerX" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                        <TextBox Grid.Column="2" x:Name="TxtLayerY" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                    </Grid>

                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Width:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                        <TextBlock Grid.Column="2" Text="Height:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtLayerWidth" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                        <TextBox Grid.Column="2" x:Name="TxtLayerHeight" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                    </Grid>
                </StackPanel>

                <!-- Group parts: for a grouped layer (Search & Buttons, Game Info) one section per part is
                     built here in code-behind, all visible at once. Hidden for single layers. -->
                <StackPanel x:Name="PnlGroupParts" Margin="0,0,0,12" Visibility="Collapsed"/>

                    <!-- File field: only for layers that show a file (Random Game Display). Shown from code-behind. -->
                    <StackPanel x:Name="PnlFileField" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Image / video file (png, jpg, gif, mp4):" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" Margin="0,0,0,3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtLayerFile" IsReadOnly="True" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4"/>
                            <Button Grid.Column="1" x:Name="BtnBrowseLayerFile" Content="Browse" Click="BtnBrowseLayerFile_Click"
                                Style="{StaticResource ThemedActionButtonStyle}"
                                Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                                Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                                BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                                BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" x:Name="BtnClearLayerFile" Content="Clear" Click="BtnClearLayerFile_Click"
                                Style="{StaticResource ThemedActionButtonStyle}"
                                Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                                Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#FFD60A}"
                                BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#FFD60A}"
                                BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Games List styling: only shown when the Games List layer is selected (code-behind).
                         Values are stored per resolution on the layer entry and apply live on Enter or focus loss. -->
                    <StackPanel x:Name="PnlGamesListStyle" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Folder Font" FontWeight="Bold" Margin="0,4,0,4"
                                   Foreground="{Binding HeaderColorHex, FallbackValue=#FFCC00}" FontSize="{Binding HeaderFontSize, FallbackValue=14}"/>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Size:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                            <TextBlock Grid.Column="2" Text="Color:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TxtGLFolderFontSize" HorizontalContentAlignment="Center" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="GLStyleField_LostFocus" KeyDown="GLStyleField_KeyDown"/>
                            <Border Grid.Column="2" Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}" BorderThickness="1">
                                <colorpicker:PortableColorPicker x:Name="GLFolderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderColorPicker_ColorChanged">
                                    <colorpicker:PortableColorPicker.Resources>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <Trigger Property="Name" Value="MainGrid">
                                                    <Setter Property="Background" Value="{Binding DataContext.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </colorpicker:PortableColorPicker.Resources>
                                </colorpicker:PortableColorPicker>
                            </Border>
                            <TextBox Grid.Column="4" x:Name="TxtGLFolderColorHex" Background="#1C1C1E" Foreground="White" BorderBrush="#3A3A3C" Padding="4" LostFocus="TxtGLFolderColorHex_LostFocus"/>
                        </Grid>

                        <TextBlock Text="Font:" Margin="0,8,0,3" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CboGLFolderFont" Width="180" Height="25"
                                      Foreground="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=White}"
                                      SelectionChanged="CboGLFolderFont_SelectionChanged">
                                <ComboBox.Template>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <ToggleButton x:Name="ToggleButton" Focusable="false"
                                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                                                BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"
                                                                BorderThickness="1">
                                                            <Path Fill="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,25,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <Border Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                                            BorderThickness="1"
                                                            BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Popup>
                                        </Grid>
                                    </ControlTemplate>
                                </ComboBox.Template>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.StandardColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                                <Setter Property="Foreground" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <CheckBox x:Name="ChkGLFolderBold" Content="Bold" Click="ChkGLFolderBold_Click" VerticalContentAlignment="Center" Margin="15,0,0,0"
                                      Foreground="{Binding StandardColorHex, FallbackValue=White}" FontSize="{Binding StandardFontSize, FallbackValue=12}"/>
                        </StackPanel>

                        <Grid Margin="0,8,0,3">
