                                                        <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                    </colorpicker:PortableColorPicker.Resources>
                                                </colorpicker:PortableColorPicker>
                                            </Border>
                                            <TextBox x:Name="GINavColorHex" Tag="Nav" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIColorHex_LostFocus"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                    <CheckBox x:Name="GINavShadow" Tag="Nav" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="GIShadow_Click"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=GINavShadow}">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GINavShadowColorPicker" Tag="Nav" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GINavShadowColorHex" Tag="Nav" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="GINavShadowBlur" Tag="Nav" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GINavShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBox x:Name="GINavShadowDepth" Tag="Nav" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GINavShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                </Grid>
                                <!-- Image Previews Nav: size / color; drop shadow -->
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Image Previews Nav" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>

                                    <!-- Size, color (side by side) -->
                                    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}"/>
                                        <TextBox x:Name="GIPreviewsNavSize" Tag="PreviewsNav" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                                 Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                            <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                                <colorpicker:PortableColorPicker x:Name="GIPreviewsNavColorPicker" Tag="PreviewsNav" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIColorPicker_ColorChanged">
                                                    <colorpicker:PortableColorPicker.Resources>
                                                        <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                    </colorpicker:PortableColorPicker.Resources>
                                                </colorpicker:PortableColorPicker>
                                            </Border>
                                            <TextBox x:Name="GIPreviewsNavColorHex" Tag="PreviewsNav" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIColorHex_LostFocus"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                    <CheckBox x:Name="GIPreviewsNavShadow" Tag="PreviewsNav" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="GIShadow_Click"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=GIPreviewsNavShadow}">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GIPreviewsNavShadowColorPicker" Tag="PreviewsNav" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GIPreviewsNavShadowColorHex" Tag="PreviewsNav" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="GIPreviewsNavShadowBlur" Tag="PreviewsNav" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIPreviewsNavShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBox x:Name="GIPreviewsNavShadowDepth" Tag="PreviewsNav" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIPreviewsNavShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Game Info - Nav Tab] -->

                    <!-- [SECTION: Game Info - Previews Tab] -->
                    <TabItem x:Name="TabGIPreviews" Header="PREVIEWS" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <!-- Image previews shadow: drop shadow (a glow is a shadow with depth 0 and a bright color) -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Image previews shadow" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Glow: set Depth to 0 and pick a bright color." TextWrapping="Wrap"
                                               Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>

                                    <!-- Drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                    <CheckBox x:Name="GIPreviewsShadow" Tag="Previews" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="GIShadow_Click"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=GIPreviewsShadow}">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GIPreviewsShadowColorPicker" Tag="Previews" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GIPreviewsShadowColorHex" Tag="Previews" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="GIPreviewsShadowBlur" Tag="Previews" Grid.Row="4" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIPreviewsShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBox x:Name="GIPreviewsShadowDepth" Tag="Previews" Grid.Row="4" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIPreviewsShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Game Info - Previews Tab] -->

                    <!-- [SECTION: Shape Layer - Background Tab] -->
                    <TabItem x:Name="TabShapeBackground" Header="BACKGROUND" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Image / video file (png, jpg, gif, mp4):" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtShapeFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseShapeFile" Content="Browse" Click="BtnBrowseShapeFile_Click"
                                            Style="{StaticResource ThemedActionButtonStyle}"
                                            FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearShapeFile" Content="Clear" Click="BtnClearShapeFile_Click"
                                            Style="{StaticResource ThemedActionButtonStyle}"
                                            FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Image / video opacity (0 to 100):" Style="{StaticResource GLLabelStyle}" Margin="0,16,0,3"/>
                                <TextBox x:Name="TxtShapeOpacity" Width="52" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeOpacityField_LostFocus" KeyDown="ShapeOpacityField_KeyDown"/>

                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,16,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="ShapeBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ShapeBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtShapeBgColorHex" Width="100" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtShapeBgColorHex_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Shape Layer - Background Tab] -->

                    <!-- [SECTION: Splash Image - Image Tab] -->
                    <!-- The splash file shown while no game is selected, stored in the Splash Image entry's ImagePath
                         (empty = the built-in splash). Sits before the Border tab so the order is Position, Image, Border. -->
                    <TabItem x:Name="TabSplashImage" Header="IMAGE" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Splash image or video (png, jpg, gif, mp4), shown when no game is selected:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSplashFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseSplashFile" Content="Browse" Click="BtnBrowseSplashFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearSplashFile" Content="Clear" Click="BtnClearSplashFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in splash." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Splash Image - Image Tab] -->

                    <!-- [SECTION: Shape Layer - Border Tab] -->
                    <TabItem x:Name="TabShapeBorder" Header="BORDER" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Border color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Size:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="Radius:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="ShapeBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="ShapeBorderColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtShapeBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtShapeBorderColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtShapeBorderSize" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeBorderField_LostFocus" KeyDown="ShapeBorderField_KeyDown"/>
                                <TextBox x:Name="TxtShapeCornerRadius" Grid.Row="1" Grid.Column="4" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="ShapeBorderField_LostFocus" KeyDown="ShapeBorderField_KeyDown"/>

                                <!-- Hover border color: Search & Buttons only (the four buttons' border while the mouse is over them) -->
                                <StackPanel x:Name="PnlSBHoverBorder" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed">
                                    <TextBlock Text="Hover border color:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="SBHoverBorderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBHoverBorderColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtSBHoverBorderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBHoverBorderColorHex_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Shape Layer - Border Tab] -->

                    <!-- [SECTION: Video Preview - Background Tab] -->
                    <!-- The fill behind and around the video (the letterbox bars), stored in the Video Preview entry's
                         BgColorHex. Not the shape layers' TabShapeBackground. -->
                    <TabItem x:Name="TabVideoBackground" Header="BACKGROUND" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="VPBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="VPBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtVPBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtVPBgColorHex_LostFocus"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Video Preview - Background Tab] -->

                    <!-- [SECTION: Video Preview - Fallback Image Tab] -->
                    <!-- The "no preview available" image shown for a game with no media, stored in the Video Preview
                         entry's ImagePath (empty = the built-in no_preview.png). -->
                    <TabItem x:Name="TabVideoFallback" Header="FALLBACK IMAGE" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Image (png, jpg, bmp), shown when the selected game has no preview:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtVPFallbackFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseVPFallback" Content="Browse" Click="BtnBrowseVPFallback_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearVPFallback" Content="Clear" Click="BtnClearVPFallback_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in image." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Video Preview - Fallback Image Tab] -->

                    <!-- [SECTION: Marquee - Logo Tab] -->
                    <TabItem x:Name="TabMarqueeLogo" Header="LOGO" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <TextBlock Text="Logo image (png, jpg), shown when no game is selected:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtMarqueeLogoFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseMarqueeLogo" Content="Browse" Click="BtnBrowseMarqueeLogo_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearMarqueeLogo" Content="Clear" Click="BtnClearMarqueeLogo_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in logo." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Marquee - Logo Tab] -->

                    <!-- [SECTION: Marquee - Shadow Tab] -->
                    <TabItem x:Name="TabMarqueeShadow" Header="SHADOW" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <!-- Logo and marquee image shadow: drop shadow (a glow is a shadow with depth 0 and a bright color) -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Logo and marquee image shadow" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Glow: set Depth to 0 and pick a bright color." TextWrapping="Wrap"
                                               Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>

                                    <!-- Drop shadow (color, blur and depth are enabled while the toggle is on) -->
                                    <CheckBox x:Name="GIMarqueeShadow" Tag="Marquee" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                              Style="{StaticResource GLCheckBoxStyle}" Click="GIShadow_Click"/>
                                    <!-- Which images get the shadow: Both, Logo only, Marquees only (game marquee and spin frames) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5" Text="Apply shadow to:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <ComboBox x:Name="GIMarqueeShadowTarget" Tag="Marquee" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Width="130" Height="25" HorizontalAlignment="Left"
                                              IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="GIShadowTarget_SelectionChanged"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GIMarqueeShadowColorPicker" Tag="Marquee" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GIShadowColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="GIMarqueeShadowColorHex" Tag="Marquee" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="GIShadowColorHex_LostFocus"/>
                                    </StackPanel>
                                    <TextBox x:Name="GIMarqueeShadowBlur" Tag="Marquee" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                    <TextBox x:Name="GIMarqueeShadowDepth" Tag="Marquee" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=GIMarqueeShadow}"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GIField_LostFocus" KeyDown="GIField_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Marquee - Shadow Tab] -->

                    <!-- [SECTION: Main Window Background - Image Tab] -->
                    <!-- The Main Window Background layer (per resolution): the background color (BgColorHex), then the wallpaper,
                         an image or a looping mp4 stored in the entry's ImagePath, plus the Disable flag (solid background color
                         only). Same layout as the Logo tab, with a color row on top. -->
                    <TabItem x:Name="TabMainBgImage" Header="IMAGE" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">
                                <!-- Background color: fills the window under the wallpaper (and alone when it is disabled); also the
                                     app's popup and dialog background -->
                                <TextBlock Text="Background color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="MainBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="MainBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtMainBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtMainBgColorHex_LostFocus"/>
                                </StackPanel>

                                <TextBlock Text="Background image or video (png, jpg, bmp, mp4):" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtMainBgFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                    <Button Grid.Column="1" x:Name="BtnBrowseMainBgFile" Content="Browse" Click="BtnBrowseMainBgFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="BtnClearMainBgFile" Content="Clear" Click="BtnClearMainBgFile_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Leave empty to use the built-in background image." Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}" Margin="0,6,0,0"/>
                                <CheckBox x:Name="ChkMainBgImageDisabled" Content="Disable Main Window Background Image (use solid Main Window Background Color only)"
                                          HorizontalAlignment="Left" Margin="0,12,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkMainBgImageDisabled_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Main Window Background - Image Tab] -->
                </TabControl>

                <!-- [SECTION: Multi-Select Nudge] -->
                <!-- Two or more rows selected: replaces the tab frame. The boxes are nudge amounts (not positions) that
                     move every selected layer together and return to 0 after each move (code-behind: LoadMultiSelection). -->
                <StackPanel Grid.Row="1" x:Name="PnlMultiSelect" Visibility="Collapsed" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Move X by (px):" Style="{StaticResource GLLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Move Y by (px):" Style="{StaticResource GLLabelStyle}"/>
                        <TextBox x:Name="TxtMultiX" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                 Style="{StaticResource GLTextBoxStyle}" LostFocus="MultiNudge_LostFocus" KeyDown="MultiNudge_KeyDown"/>
                        <TextBox x:Name="TxtMultiY" Grid.Row="1" Grid.Column="2" HorizontalContentAlignment="Center"
                                 Style="{StaticResource GLTextBoxStyle}" LostFocus="MultiNudge_LostFocus" KeyDown="MultiNudge_KeyDown"/>
                    </Grid>
                    <TextBlock x:Name="TxtMultiHint" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource Global.Font.SubText.Color}" FontSize="{DynamicResource Global.Font.SubText.Size}"/>
                </StackPanel>
                <!-- [END SECTION: Multi-Select Nudge] -->

                <!-- Layer-wide buttons, pinned below the tab frame so they sit in the same place on every tab and layer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <!-- Rename: shape layers and custom layers only (shown from code) -->
                    <Button x:Name="BtnRenameLayer" Content="Rename" Click="BtnRenameLayer_Click" Visibility="Collapsed"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3"/>
                    <Button x:Name="BtnResetLayer" Content="Reset Layer" Click="BtnResetLayer_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnRemoveLayer" Content="Remove Layer" Click="BtnRemoveLayer_Click" Visibility="Collapsed"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <!-- [END SECTION: Layer Property Tabs] -->
        </Grid>
        <!-- [END SECTION: Layer List + Fields] -->
    </Grid>
</UserControl>
