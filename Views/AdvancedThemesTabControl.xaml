<UserControl x:Class="ArcadeStick.Views.AdvancedThemesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d">

    <!-- The shared control styles this tab uses (PickerPopupGridStyle, GLLabelStyle, GLTextBoxStyle, GLCheckBoxStyle,
         GlyphToggleStyle, ChromeComboBoxStyle, ChromeListBoxStyle) live in App.xaml: [SECTION: Theme Builder Shared Styles]
         and [SECTION: Chrome Control Styles]. -->

    <UserControl.Resources>
        <!-- [SECTION: Layers Help] -->
        <!-- The Layers header's help: the tooltip text (one line per point; edit it only here) and the circled ? glyph's look
             (Chrome Palette only; the ring and the ? turn accent on hover). The tooltip is the default Windows tooltip. -->
        <sys:String x:Key="LayersHelpText" xml:space="preserve">Right-click a layer to copy its position, size or border, then right-click another layer (or one of several selected layers) to paste. Search &amp; Buttons, Game Info, the Footer and the Main Window Background have no copy or paste.&#10;Ctrl-click or Shift-click to select several layers and move them together with the Move X / Move Y boxes.&#10;Use the arrows beside the list to bring a layer forward or send it backward. Double-click a shape or custom layer to rename it.</sys:String>

        <Style x:Key="LayersHelpGlyphStyle" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource ChromeTextMuted}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource ChromeTextMuted}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource ChromeAccent}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource ChromeAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- [END SECTION: Layers Help] -->
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [SECTION: Resolution Row] -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <!-- Theme sizes: one button per size saved in the theme file (filled from code-behind) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Theme sizes:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <WrapPanel x:Name="PnlSavedSizes" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom resolution entry: shown only after "Custom..." is picked in the combo box -->
                <StackPanel x:Name="PnlCustomRes" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="Custom size:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtCustomWidth" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" KeyDown="CustomRes_KeyDown"/>
                    <TextBlock Text="x" Foreground="{DynamicResource Global.Font.Standard.Color}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="TxtCustomHeight" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" KeyDown="CustomRes_KeyDown"/>
                    <Button x:Name="BtnAddCustomRes" Content="Apply" Click="BtnAddCustomRes_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="10,3" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="0" Text="Resolution:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" x:Name="CboResolution" Width="140" Height="25"
                          Style="{StaticResource ChromeComboBoxStyle}"
                          SelectionChanged="CboResolution_SelectionChanged"/>

                <!-- Alignment guides and background grid: editor aids (not saved in the theme; the grid, its spacing and its
                     offsets are session-only). Handlers live in code-behind. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="ChkShowGuides" Content="Edge guides" Click="ChkShowGuides_Click" Margin="0,0,15,0"
                              Style="{StaticResource GLCheckBoxStyle}"/>
                    <CheckBox x:Name="ChkCenterGuides" Content="Center guides" Click="ChkCenterGuides_Click" Margin="0,0,15,0"
                              Style="{StaticResource GLCheckBoxStyle}"/>
                    <TextBlock Text="Color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="GuideColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GuideColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <CheckBox x:Name="ChkBgGrid" Content="Grid" Click="ChkBgGrid_Click" Margin="15,0,0,0"
                              Style="{StaticResource GLCheckBoxStyle}"/>
                    <TextBox x:Name="TxtGridSpacing" Width="52" Margin="5,0,0,0" Text="20" HorizontalContentAlignment="Center" ToolTip="Grid spacing (px)"
                             Style="{StaticResource GLTextBoxStyle}" KeyDown="TxtGridSpacing_KeyDown" LostFocus="TxtGridSpacing_LostFocus"/>
                    <!-- Grid offset X / Y: empty = 0. The muted letter on top is shown only while the box is empty
                         (visibility set from code-behind, not a trigger). -->
                    <TextBlock Text="Offset:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="15,0,10,0"/>
                    <Grid>
                        <TextBox x:Name="TxtGridOffsetX" Width="52" HorizontalContentAlignment="Center" ToolTip="Grid offset X (px)"
                                 Style="{StaticResource GLTextBoxStyle}" KeyDown="TxtGridOffset_KeyDown" LostFocus="TxtGridOffset_LostFocus" TextChanged="TxtGridOffset_TextChanged"/>
                        <TextBlock x:Name="PhGridOffsetX" Text="X" FontSize="13" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ChromeTextMuted}"/>
                    </Grid>
                    <Grid Margin="5,0,0,0">
                        <TextBox x:Name="TxtGridOffsetY" Width="52" HorizontalContentAlignment="Center" ToolTip="Grid offset Y (px)"
                                 Style="{StaticResource GLTextBoxStyle}" KeyDown="TxtGridOffset_KeyDown" LostFocus="TxtGridOffset_LostFocus" TextChanged="TxtGridOffset_TextChanged"/>
                        <TextBlock x:Name="PhGridOffsetY" Text="Y" FontSize="13" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource ChromeTextMuted}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnResetLayout" Content="Reset Layout" Click="BtnResetLayout_Click" HorizontalAlignment="Left"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnDeleteCustomRes" Content="Delete Size" Click="BtnDeleteCustomRes_Click" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnRestoreDefaults" Content="Restore Defaults" Click="BtnRestoreDefaults_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <!-- [END SECTION: Resolution Row] -->

        <!-- [SECTION: Layer List + Fields] -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Layer list (frontmost at top) with up/down arrows beside it, under the Layers header -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Layers header: same font values and bottom margin as TxtLayerName (outside PnlLayerFields, so it always
                     shows), so the two headings share a top edge. The text is top-aligned so a taller glyph never moves it. -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Layers" VerticalAlignment="Top"
                               Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}"/>
                    <Border Style="{StaticResource LayersHelpGlyphStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="60000">
                        <Border.ToolTip>
                            <TextBlock Text="{StaticResource LayersHelpText}" TextWrapping="Wrap" MaxWidth="380"/>
                        </Border.ToolTip>
                        <TextBlock Text="?" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right-click Copy / Paste: the items are built in code each time the menu opens (LstLayers_ContextMenuOpening);
                     right-clicking a row outside the selection selects it first (the ListBox's own behavior). -->
                <ListBox x:Name="LstLayers" Grid.Row="1" Grid.Column="0" DisplayMemberPath="DisplayName" SelectionMode="Extended" SelectionChanged="LstLayers_SelectionChanged" MouseDoubleClick="LstLayers_MouseDoubleClick"
                         ContextMenuOpening="LstLayers_ContextMenuOpening"
                         Style="{StaticResource ChromeListBoxStyle}">
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{StaticResource BuilderContextMenuStyle}"/>
                    </ListBox.ContextMenu>
                </ListBox>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="BtnLayerUp" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Click="BtnLayerUp_Click" ToolTip="Bring forward" Width="30" Height="30" Margin="0,0,0,6"
                            Style="{StaticResource ThemedActionButtonStyle}"/>
                    <Button x:Name="BtnLayerDown" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Click="BtnLayerDown_Click" ToolTip="Send backward" Width="30" Height="30" Margin="0,0,0,6"
                            Style="{StaticResource ThemedActionButtonStyle}"/>
                    <Button x:Name="BtnAddImageLayer" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="BtnAddImageLayer_Click" ToolTip="Add layer" Width="30" Height="30"
                            Style="{StaticResource ThemedActionButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- [SECTION: Layer Property Tabs] -->
            <!-- Selected layer: its name, a tab frame, and the layer-wide buttons pinned below it. Position is
                 always present; the other tabs are shown per layer type from code-behind (ApplyLayerTabs).
                 Each tab scrolls on its own: long tabs (for example Search, Info, Position on groups and the
                 Random Game Display Text tab) show a vertical scrollbar at the current window size. -->
            <Grid Grid.Column="2" x:Name="PnlLayerFields" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TxtLayerName" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,8"/>

                    <!-- Random Game Display only: session-only card preview on the main window, in the chosen state.
                         Turned off by selecting another layer, a resolution switch, a theme load, leaving the tab,
                         closing the builder, or a real spin. -->
                    <StackPanel x:Name="PnlRandomPreview" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                        <CheckBox x:Name="ChkRandomPreview" Content="Preview card" Click="ChkRandomPreview_Click" VerticalAlignment="Center" Margin="0,0,15,0"
                                  Style="{StaticResource GLCheckBoxStyle}"/>
                        <TextBlock Text="Preview as:" Style="{StaticResource GLLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="CboRandomPreviewState" Width="200" Height="25"
                                  Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboRandomPreviewState_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>

                <TabControl Grid.Row="1" x:Name="TabsLayer" Style="{StaticResource ThemedTabControlStyle}" Background="Transparent">

                    <!-- [SECTION: Position Tab] -->
                    <TabItem x:Name="TabPosition" Header="POSITION">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">

                                <!-- X / Y on one row, Width / Height on the next. The lock toggle sits between Width and Height;
                                     when on, editing one of them resizes the other to keep the ratio (not saved). -->
                                <Grid x:Name="PnlRectFields" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtLayerX" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtLayerY" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Width:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Height:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox Grid.Row="3" Grid.Column="0" x:Name="TxtLayerWidth" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                    <ToggleButton Grid.Row="3" Grid.Column="1" x:Name="BtnRatioLock" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Style="{StaticResource GlyphToggleStyle}" ToolTip="Lock aspect ratio"/>
                                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="TxtLayerHeight" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                </Grid>

                                <!-- Group move: for groups that allow it (Search & Buttons, Game Info), an X or Y edit on one
                                     part moves every part by the same amount. Session-only, like the ratio lock. -->
                                <CheckBox x:Name="ChkGroupMove" Content="Move all parts together" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Style="{StaticResource GLCheckBoxStyle}" Visibility="Collapsed"/>

                                <!-- Group parts: for a grouped layer (Search & Buttons, Game Info, Random Game Display) one section
                                     per part is built here in code-behind, all visible at once (with a per-part ratio lock where
                                     the group allows it). Hidden for single layers. -->
                                <StackPanel x:Name="PnlGroupParts" Margin="0,0,0,12" Visibility="Collapsed"/>

                                <CheckBox x:Name="ChkLayerHidden" Content="Hide this layer" Click="ChkLayerHidden_Click" HorizontalAlignment="Left"
                                          Style="{StaticResource GLCheckBoxStyle}" Margin="0,6,0,0"/>

                                <!-- Visibility mode: replaces the Hide checkbox on Shape Layers. Items are filled from code-behind. -->
                                <StackPanel x:Name="PnlVisibilityMode" Margin="0,6,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Visibility:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CboVisibilityMode" Width="220" Height="25" HorizontalAlignment="Left"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboVisibilityMode_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Position Tab] -->

                    <!-- [SECTION: Games List - Folders Tab] -->
                    <!-- Layout, top to bottom: font + bold; size / color; shadow toggle; shadow color / blur / depth;
                         gap; selected text / selected BG; shadow toggle; shadow color / blur / depth; gap; arrow.
                         Columns line up from row to row: 0 is the first control, 2 to 4 the second (or blur and
                         depth on a shadow row), 6 holds Bold. -->
                    <TabItem x:Name="TabGLFolders" Header="FOLDERS" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Font family + bold -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Font:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <ComboBox x:Name="CboGLFolderFont" Width="160" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboGLFolderFont_SelectionChanged"/>
                                    <CheckBox x:Name="ChkGLFolderBold" Content="Bold" Margin="12,0,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLFolderBold_Click"/>
                                </StackPanel>

                                <!-- Normal state: size, color (side by side) -->
                                <Grid Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox x:Name="TxtGLFolderFontSize" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GLStyleField_LostFocus" KeyDown="GLStyleField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GLFolderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtGLFolderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Normal state: drop shadow -->
                                <CheckBox x:Name="ChkGLFolderShadow" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLFolderShadow_Click"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderShadowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGLFolderShadowBlur" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>
                                <TextBox x:Name="TxtGLFolderShadowDepth" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>

                                <!-- Selected state: text color, background -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Selected text:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3" Text="Selected BG:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderSelectedColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderSelectedColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderSelectedColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderSelectedColorHex_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderSelectedBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderSelectedBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderSelectedBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderSelectedBgColorHex_LostFocus"/>
                                </StackPanel>

                                <!-- Selected state: drop shadow -->
                                <CheckBox x:Name="ChkGLFolderSelShadow" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLFolderSelShadow_Click"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="11" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderSelShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderSelShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderSelShadowColorPicker_ColorChanged">
