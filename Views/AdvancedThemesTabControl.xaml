<UserControl x:Class="ArcadeStick.Views.AdvancedThemesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             mc:Ignorable="d">

    <!-- The shared control styles this tab uses (PickerPopupGridStyle, GLLabelStyle, GLTextBoxStyle, GLCheckBoxStyle,
         GlyphToggleStyle, ChromeComboBoxStyle, ChromeListBoxStyle) live in App.xaml: [SECTION: Theme Builder Shared Styles]
         and [SECTION: Chrome Control Styles]. -->

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [SECTION: Guide] -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="THEME BUILDER" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,10"/>
            <TextBlock Text="Choose a resolution, then select a layer to set its position, size and visibility. Layers higher in the list draw on top. Values apply when you press Enter or leave the field. Save Adjustments writes them to settings.json; Save Changes on the Basic Themes tab writes them into the theme file."
                       Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- [END SECTION: Guide] -->

        <!-- [SECTION: Resolution Row] -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">

            <!-- Theme sizes: one button per size saved in the theme file (filled from code-behind) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Theme sizes:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <WrapPanel x:Name="PnlSavedSizes" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom resolution entry: shown only after "Custom..." is picked in the combo box -->
                <StackPanel x:Name="PnlCustomRes" Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="Custom size:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="TxtCustomWidth" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" KeyDown="CustomRes_KeyDown"/>
                    <TextBlock Text="x" Foreground="{DynamicResource Global.Font.Standard.Color}" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox x:Name="TxtCustomHeight" Width="70" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" KeyDown="CustomRes_KeyDown"/>
                    <Button x:Name="BtnAddCustomRes" Content="Apply" Click="BtnAddCustomRes_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="10,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnKeepCustomRes" Content="Keep" Click="BtnKeepCustomRes_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="10,3" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="0" Text="Resolution:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1" x:Name="CboResolution" Width="140" Height="25"
                          Style="{StaticResource ChromeComboBoxStyle}"
                          SelectionChanged="CboResolution_SelectionChanged"/>

                <!-- Alignment guides: editor preferences (not saved in the theme). Handlers live in code-behind. -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="ChkShowGuides" Content="Show guides" Click="ChkShowGuides_Click" Margin="0,0,15,0"
                              Style="{StaticResource GLCheckBoxStyle}"/>
                    <TextBlock Text="Guide color:" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="GuideColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GuideColorPicker_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox x:Name="TxtGuideColorHex" Width="100" Margin="5,0,0,0" Text="#FF00FFFF" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGuideColorHex_LostFocus"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnResetLayout" Content="Reset Layout" Click="BtnResetLayout_Click" HorizontalAlignment="Left"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnDeleteCustomRes" Content="Delete Size" Click="BtnDeleteCustomRes_Click" Visibility="Collapsed"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                    <Button x:Name="BtnRestoreDefaults" Content="Restore Defaults" Click="BtnRestoreDefaults_Click"
                            Style="{StaticResource ThemedActionButtonStyle}"
                            FontWeight="SemiBold" Padding="7,3" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <!-- [END SECTION: Resolution Row] -->

        <!-- [SECTION: Layer List + Fields] -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Layer list (frontmost at top) with up/down arrows beside it -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="LstLayers" Grid.Column="0" DisplayMemberPath="DisplayName" SelectionMode="Extended" SelectionChanged="LstLayers_SelectionChanged" MouseDoubleClick="LstLayers_MouseDoubleClick"
                         Style="{StaticResource ChromeListBoxStyle}"/>

                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Button x:Name="BtnLayerUp" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Click="BtnLayerUp_Click" ToolTip="Bring forward" Width="30" Height="30" Margin="0,0,0,6"
                            Style="{StaticResource ThemedActionButtonStyle}"/>
                    <Button x:Name="BtnLayerDown" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Click="BtnLayerDown_Click" ToolTip="Send backward" Width="30" Height="30" Margin="0,0,0,6"
                            Style="{StaticResource ThemedActionButtonStyle}"/>
                    <Button x:Name="BtnAddImageLayer" Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="BtnAddImageLayer_Click" ToolTip="Add layer" Width="30" Height="30"
                            Style="{StaticResource ThemedActionButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- [SECTION: Layer Property Tabs] -->
            <!-- Selected layer: its name, a tab frame, and the layer-wide buttons pinned below it. Position is
                 always present; the other tabs are shown per layer type from code-behind (ApplyLayerTabs).
                 Each tab scrolls on its own, but the window is sized so nothing scrolls unless it is shrunk. -->
            <Grid Grid.Column="2" x:Name="PnlLayerFields" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TxtLayerName" Foreground="{DynamicResource Global.Font.Header.Color}" FontWeight="Bold" FontSize="{DynamicResource Global.Font.Header.Size}" Margin="0,0,0,8"/>

                <TabControl Grid.Row="1" x:Name="TabsLayer" Style="{StaticResource ThemedTabControlStyle}" Background="Transparent">

                    <!-- [SECTION: Position Tab] -->
                    <TabItem x:Name="TabPosition" Header="POSITION">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <StackPanel Margin="10">

                                <!-- X / Y on one row, Width / Height on the next. The lock toggle sits between Width and Height;
                                     when on, editing one of them resizes the other to keep the ratio (not saved). -->
                                <Grid x:Name="PnlRectFields" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="TxtLayerX" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="TxtLayerY" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Width:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Height:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox Grid.Row="3" Grid.Column="0" x:Name="TxtLayerWidth" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                    <ToggleButton Grid.Row="3" Grid.Column="1" x:Name="BtnRatioLock" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Style="{StaticResource GlyphToggleStyle}" ToolTip="Lock aspect ratio"/>
                                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="TxtLayerHeight" HorizontalContentAlignment="Center" Style="{StaticResource GLTextBoxStyle}" LostFocus="LayerField_LostFocus" KeyDown="LayerField_KeyDown"/>
                                </Grid>

                                <!-- Group move: for groups that allow it (Search & Buttons, Game Info), an X or Y edit on one
                                     part moves every part by the same amount. Session-only, like the ratio lock. -->
                                <CheckBox x:Name="ChkGroupMove" Content="Move all parts together" HorizontalAlignment="Left" Margin="0,0,0,8"
                                          Style="{StaticResource GLCheckBoxStyle}" Visibility="Collapsed"/>

                                <!-- Group parts: for a grouped layer (Search & Buttons, Game Info) one section per part is
                                     built here in code-behind, all visible at once. Hidden for single layers. -->
                                <StackPanel x:Name="PnlGroupParts" Margin="0,0,0,12" Visibility="Collapsed"/>

                                <!-- File field: only for layers that show a file (Random Game Display). Shown from code-behind. -->
                                <StackPanel x:Name="PnlFileField" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Image / video file (png, jpg, gif, mp4):" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TxtLayerFile" IsReadOnly="True" Style="{StaticResource GLTextBoxStyle}"/>
                                        <Button Grid.Column="1" x:Name="BtnBrowseLayerFile" Content="Browse" Click="BtnBrowseLayerFile_Click"
                                                Style="{StaticResource ThemedActionButtonStyle}"
                                                FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                        <Button Grid.Column="2" x:Name="BtnClearLayerFile" Content="Clear" Click="BtnClearLayerFile_Click"
                                                Style="{StaticResource ThemedActionButtonStyle}"
                                                FontWeight="SemiBold" Padding="7,3" Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <CheckBox x:Name="ChkLayerHidden" Content="Hide this layer" Click="ChkLayerHidden_Click" HorizontalAlignment="Left"
                                          Style="{StaticResource GLCheckBoxStyle}" Margin="0,6,0,0"/>

                                <!-- Visibility mode: replaces the Hide checkbox on Shape Layers. Items are filled from code-behind. -->
                                <StackPanel x:Name="PnlVisibilityMode" Margin="0,6,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Visibility:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CboVisibilityMode" Width="220" Height="25" HorizontalAlignment="Left"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboVisibilityMode_SelectionChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Position Tab] -->

                    <!-- [SECTION: Games List - Folders Tab] -->
                    <!-- Layout, top to bottom: font + bold; size / color; shadow toggle; shadow color / blur / depth;
                         gap; selected text / selected BG; shadow toggle; shadow color / blur / depth; gap; arrow.
                         Columns line up from row to row: 0 is the first control, 2 to 4 the second (or blur and
                         depth on a shadow row), 6 holds Bold. -->
                    <TabItem x:Name="TabGLFolders" Header="FOLDERS" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Font family + bold -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Font:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <ComboBox x:Name="CboGLFolderFont" Width="160" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboGLFolderFont_SelectionChanged"/>
                                    <CheckBox x:Name="ChkGLFolderBold" Content="Bold" Margin="12,0,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLFolderBold_Click"/>
                                </StackPanel>

                                <!-- Normal state: size, color (side by side) -->
                                <Grid Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox x:Name="TxtGLFolderFontSize" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GLStyleField_LostFocus" KeyDown="GLStyleField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GLFolderColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtGLFolderColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Normal state: drop shadow -->
                                <CheckBox x:Name="ChkGLFolderShadow" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLFolderShadow_Click"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderShadowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGLFolderShadowBlur" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>
                                <TextBox x:Name="TxtGLFolderShadowDepth" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>

                                <!-- Selected state: text color, background -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Selected text:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3" Text="Selected BG:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderSelectedColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderSelectedColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderSelectedColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderSelectedColorHex_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderSelectedBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderSelectedBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderSelectedBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderSelectedBgColorHex_LostFocus"/>
                                </StackPanel>

                                <!-- Selected state: drop shadow -->
                                <CheckBox x:Name="ChkGLFolderSelShadow" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLFolderSelShadow_Click"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="11" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderSelShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLFolderSelShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLFolderSelShadowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLFolderSelShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLFolderSelShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGLFolderSelShadowBlur" Grid.Row="11" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderSelShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>
                                <TextBox x:Name="TxtGLFolderSelShadowDepth" Grid.Row="11" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLFolderSelShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>

                                <!-- Expand/collapse arrow -->
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Arrow color:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <TextBlock Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="3" Text="Nudge (px):" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <StackPanel Grid.Row="13" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLArrowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLArrowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLArrowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLArrowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGLArrowNudge" Grid.Row="13" Grid.Column="2" Grid.ColumnSpan="3" Width="48" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLArrowNudge_LostFocus" KeyDown="GLArrowNudge_KeyDown"/>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Games List - Folders Tab] -->

                    <!-- [SECTION: Games List - Game Titles Tab] -->
                    <!-- Same layout as the Folders tab, with the hover color (color only, no shadow) in place of the arrow. -->
                    <TabItem x:Name="TabGLGameTitles" Header="GAME TITLES" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Font family + bold -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Font:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <ComboBox x:Name="CboGLGameFont" Width="160" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboGLGameFont_SelectionChanged"/>
                                    <CheckBox x:Name="ChkGLGameBold" Content="Bold" Margin="12,0,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLGameBold_Click"/>
                                </StackPanel>

                                <!-- Normal state: size, color (side by side) -->
                                <Grid Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox x:Name="TxtGLGameFontSize" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="GLGameSizeField_LostFocus" KeyDown="GLGameSizeField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="GLGameColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLGameColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtGLGameColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLGameColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Normal state: drop shadow -->
                                <CheckBox x:Name="ChkGLGameShadow" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLGameShadow_Click"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkGLGameShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLGameShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLGameShadowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLGameShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLGameShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGLGameShadowBlur" Grid.Row="6" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLGameShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>
                                <TextBox x:Name="TxtGLGameShadowDepth" Grid.Row="6" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLGameShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>

                                <!-- Selected state: text color, background -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Selected text:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3" Text="Selected BG:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLGameSelectedColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLGameSelectedColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLGameSelectedColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLGameSelectedColorHex_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLGameSelectedBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLGameSelectedBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLGameSelectedBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLGameSelectedBgColorHex_LostFocus"/>
                                </StackPanel>

                                <!-- Selected state: drop shadow -->
                                <CheckBox x:Name="ChkGLGameSelShadow" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkGLGameSelShadow_Click"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="10" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="11" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkGLGameSelShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLGameSelShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLGameSelShadowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLGameSelShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLGameSelShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtGLGameSelShadowBlur" Grid.Row="11" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLGameSelShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>
                                <TextBox x:Name="TxtGLGameSelShadowDepth" Grid.Row="11" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkGLGameSelShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="GLShadowField_LostFocus" KeyDown="GLShadowField_KeyDown"/>

                                <!-- Hover color (color only, no shadow) -->
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Hover color:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <StackPanel Grid.Row="13" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="GLGameHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="GLGameHoverColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtGLGameHoverColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtGLGameHoverColorHex_LostFocus"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Games List - Game Titles Tab] -->

                    <!-- [SECTION: Search & Buttons - Search Tab] -->
                    <!-- Label: font + bold; size / color; background; alignment; vertical nudge; drop shadow. Then the search box:
                         size / color; background. Label values live on the SearchLabel entry, box values on the
                         SearchBox entry. Same column grid as the Games List tabs. -->
                    <TabItem x:Name="TabSBSearch" Header="SEARCH" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Label: font family + bold -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Text="Label" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Text="Font:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <ComboBox x:Name="CboSBLabelFont" Width="160" Height="25"
                                              Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboSBLabelFont_SelectionChanged"/>
                                    <CheckBox x:Name="ChkSBLabelBold" Content="Bold" Margin="12,0,0,0" Style="{StaticResource GLCheckBoxStyle}" Click="ChkSBLabelBold_Click"/>
                                </StackPanel>

                                <!-- Label: size, color (side by side) -->
                                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}"/>
                                    <TextBox x:Name="TxtSBLabelFontSize" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="SBField_LostFocus" KeyDown="SBField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="SBLabelColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBLabelColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtSBLabelColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBLabelColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Label: background, then text alignment -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Background:" Style="{StaticResource GLLabelStyle}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Text="Alignment:" Style="{StaticResource GLLabelStyle}"/>
                                <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="SBLabelBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBLabelBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtSBLabelBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBLabelBgColorHex_LostFocus"/>
                                </StackPanel>
                                <ComboBox x:Name="CboSBLabelAlign" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" Width="110" Height="25" HorizontalAlignment="Left"
                                          Style="{StaticResource ChromeComboBoxStyle}" SelectionChanged="CboSBLabelAlign_SelectionChanged"/>

                                <!-- Label: vertical nudge (moves only the text, -10 to 10 px) -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5" Text="Vertical nudge (px):" Style="{StaticResource GLLabelStyle}"/>
                                <TextBox x:Name="TxtSBLabelNudge" Grid.Row="7" Grid.Column="0" Width="48" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="SBField_LostFocus" KeyDown="SBField_KeyDown"/>

                                <!-- Label: drop shadow -->
                                <CheckBox x:Name="ChkSBLabelShadow" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5" Content="Drop shadow" Margin="0,8,0,0"
                                          Style="{StaticResource GLCheckBoxStyle}" Click="ChkSBLabelShadow_Click"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Shadow color:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="9" Grid.Column="2" Text="Blur:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <TextBlock Grid.Row="9" Grid.Column="4" Text="Depth:" Style="{StaticResource GLLabelStyle}" Margin="0,6,0,3"/>
                                <StackPanel Grid.Row="10" Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsChecked, ElementName=ChkSBLabelShadow}">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="SBLabelShadowColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBLabelShadowColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtSBLabelShadowColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBLabelShadowColorHex_LostFocus"/>
                                </StackPanel>
                                <TextBox x:Name="TxtSBLabelShadowBlur" Grid.Row="10" Grid.Column="2" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkSBLabelShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="SBField_LostFocus" KeyDown="SBField_KeyDown"/>
                                <TextBox x:Name="TxtSBLabelShadowDepth" Grid.Row="10" Grid.Column="4" HorizontalContentAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkSBLabelShadow}"
                                         Style="{StaticResource GLTextBoxStyle}" LostFocus="SBField_LostFocus" KeyDown="SBField_KeyDown"/>

                                <!-- Search box: size, color (side by side) -->
                                <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="5" Text="Search box" FontWeight="Bold" Style="{StaticResource GLLabelStyle}" Margin="0,24,0,3"/>
                                <Grid Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}" Margin="0,4,0,3"/>
                                    <TextBox x:Name="TxtSBBoxFontSize" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="SBField_LostFocus" KeyDown="SBField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="SBBoxColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBBoxColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtSBBoxColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBBoxColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Search box: background -->
                                <TextBlock Grid.Row="13" Grid.Column="0" Text="Background:" Style="{StaticResource GLLabelStyle}"/>
                                <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="SBBoxBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBBoxBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtSBBoxBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBBoxBgColorHex_LostFocus"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <!-- [END SECTION: Search & Buttons - Search Tab] -->

                    <!-- [SECTION: Search & Buttons - Buttons Tab] -->
                    <!-- One style shared by the Random, Sort, Options and Hamburger buttons, stored on the Random Game
                         Button entry: size / color; background; hover color / hover background. Border is on the
                         BORDER tab. -->
                    <TabItem x:Name="TabSBButtons" Header="BUTTONS" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewerThemed}">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Size, color (side by side) -->
                                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Color:" Style="{StaticResource GLLabelStyle}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="TxtSBButtonFontSize" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center"
                                             Style="{StaticResource GLTextBoxStyle}" LostFocus="SBField_LostFocus" KeyDown="SBField_KeyDown"/>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                                        <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                            <colorpicker:PortableColorPicker x:Name="SBButtonColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBButtonColorPicker_ColorChanged">
                                                <colorpicker:PortableColorPicker.Resources>
                                                    <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                                </colorpicker:PortableColorPicker.Resources>
                                            </colorpicker:PortableColorPicker>
                                        </Border>
                                        <TextBox x:Name="TxtSBButtonColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBButtonColorHex_LostFocus"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Background -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Background:" Style="{StaticResource GLLabelStyle}"/>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="SBButtonBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBButtonBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtSBButtonBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBButtonBgColorHex_LostFocus"/>
                                </StackPanel>

                                <!-- Hover state: icon color, background -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Hover color:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Text="Hover BG:" Style="{StaticResource GLLabelStyle}" Margin="0,20,0,3"/>
                                <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="SBButtonHoverColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBButtonHoverColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtSBButtonHoverColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBButtonHoverColorHex_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{StaticResource ChromeBorder}" BorderThickness="1">
                                        <colorpicker:PortableColorPicker x:Name="SBButtonHoverBgColorPicker" Width="26" Height="26" ShowAlpha="True" HexRepresentation="ARGB" ColorChanged="SBButtonHoverBgColorPicker_ColorChanged">
                                            <colorpicker:PortableColorPicker.Resources>
                                                <Style TargetType="Grid" BasedOn="{StaticResource PickerPopupGridStyle}"/>
                                            </colorpicker:PortableColorPicker.Resources>
                                        </colorpicker:PortableColorPicker>
                                    </Border>
                                    <TextBox x:Name="TxtSBButtonHoverBgColorHex" Width="80" Margin="4,0,0,0" Style="{StaticResource GLTextBoxStyle}" LostFocus="TxtSBButtonHoverBgColorHex_LostFocus"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
