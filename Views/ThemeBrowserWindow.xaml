<Window x:Class="ArcadeStick.Views.ThemeBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArcadeStick.Views"
        Title="4RCADE 5TICK Theme Browser" Height="860" Width="717" MinHeight="400" MinWidth="520"
        Background="{DynamicResource Global.Options.Bg}"
        BorderBrush="{StaticResource ChromeBorder}"
        BorderThickness="1">

    <!-- Root: the window content, then the preview overlay above all of it (outer margin, tab and button row), collapsed
         until a thumbnail is clicked. Same frame as the Sorting window: one themed tab (its TabContentBorder gives the
         Options border and the scrollbar clearance) and a Close Window button. -->
    <Grid>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- [SECTION: Tab Page] -->
        <TabControl Grid.Row="0" Style="{StaticResource ThemedTabControlStyle}">
            <TabItem Header="THEME BROWSER">
                <views:ThemeBrowserControl x:Name="ThemeBrowser"/>
            </TabItem>
        </TabControl>
        <!-- [END SECTION: Tab Page] -->

        <!-- [SECTION: Close Button Row] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Close Window" x:Name="BtnCloseBrowser" Click="BtnCloseBrowser_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Padding="15,6"/>
        </StackPanel>
        <!-- [END SECTION: Close Button Row] -->
    </Grid>

    <!-- [SECTION: Theme Preview Overlay] -->
    <views:ThemePreviewOverlay x:Name="PreviewOverlay"/>
    <!-- [END SECTION: Theme Preview Overlay] -->
    </Grid>
</Window>
