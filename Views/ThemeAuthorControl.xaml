<UserControl x:Class="ArcadeStick.Views.ThemeAuthorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBlock x:Name="TxtValue" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>

        <StackPanel x:Name="PnlEdit" Visibility="Collapsed">
            <TextBox x:Name="TxtEdit" Style="{StaticResource GLTextBoxStyle}" KeyDown="TxtEdit_KeyDown"/>
            <Button Content="Apply" Click="BtnApply_Click" HorizontalAlignment="Left" Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="SemiBold" Padding="10,3" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
