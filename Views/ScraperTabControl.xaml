<UserControl x:Class="ArcadeStick.Views.ScraperTabControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick.Views"
        mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5,5,5" Style="{StaticResource ArcadeDarkScrollViewer}">
        <StackPanel Margin="15">
            <TextBlock Text="ARTWORK SCRAPER" 
                       FontWeight="Bold" Margin="0,0,0,8"
                       FontSize="{Binding HeaderFontSize, FallbackValue=14}"
                       Foreground="{Binding HeaderColorHex, FallbackValue=#FFef44c3}"/>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                       FontSize="{Binding StandardFontSize, FallbackValue=13}"
                       Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}"
                       Text="When enabled, missing artwork is fetched automatically in the background after you launch a game, or on demand from a game's right-click menu. Nothing downloads until you turn this on."/>

            <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,5,0,15"/>

            <!-- [SECTION: Master Enable] -->
            <CheckBox x:Name="ChkScraperEnabled" Content="Enable Artwork Scraper" 
                      Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" 
                      FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"
                      FontWeight="Bold"
                      Margin="0,0,0,15"/>
            <!-- [END SECTION: Master Enable] -->

            <!-- [SECTION: Trigger Toggles] -->
            <TextBlock Text="Triggers:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchOnLaunch" Content="Fetch missing artwork in the background after launching a game" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchOnContextMenu" Content="Enable &quot;Get Artwork&quot; option in the game right-click menu" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,15"/>
            <!-- [END SECTION: Trigger Toggles] -->

            <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

            <!-- [SECTION: Category Checkboxes] -->
            <TextBlock Text="Asset Types to Fetch:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchMarquees" Content="Marquees" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchFlyers" Content="Flyers" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchTitlescreens" Content="Title Screens" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchSnaps" Content="Gameplay Snaps" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchCabinets" Content="Cabinets" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,5"/>
            <CheckBox x:Name="ChkFetchVideos" Content="Videos (larger downloads)" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,15"/>
            <!-- [END SECTION: Category Checkboxes] -->

            <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

            <!-- [SECTION: Behavior Options] -->
            <CheckBox x:Name="ChkOverwriteExisting" Content="Overwrite existing local files (unchecked = skip files you already have)" 
                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                      FontSize="{Binding StandardFontSize, FallbackValue=13}"
                      Margin="0,0,0,15"/>
            <!-- [END SECTION: Behavior Options] -->

            <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

            <!-- [SECTION: Status / Diagnostics] -->
            <TextBlock Text="Status:" Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}" FontSize="{Binding SubHeaderFontSize, FallbackValue=13}" Margin="0,0,0,5"/>
            <TextBlock x:Name="TxtScraperStatus" Text="Not yet checked." TextWrapping="Wrap"
                       FontSize="{Binding StandardFontSize, FallbackValue=13}"
                       Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                       Margin="0,0,0,8"/>
            <Button x:Name="BtnTestConnection" Click="BtnTestConnection_Click" Content="Test Connection" 
                    HorizontalAlignment="Left"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Background="{Binding BtnBgColorHex, FallbackValue=#2C2C2E}" 
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=White}" 
                    BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#3A3A3C}" BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}"
                    Padding="10,5" Margin="0,0,0,15"/>
            <!-- [END SECTION: Status / Diagnostics] -->

            <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

            <!-- [SECTION: Attribution] -->
            <TextBlock TextWrapping="Wrap" 
                       FontSize="{Binding StandardFontSize, FallbackValue=13}"
                       Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" 
                       Text="Artwork provided by Arcade Database (ADB) by motoschifo - adb.arcadeitalia.net"/>
            <!-- [END SECTION: Attribution] -->

        </StackPanel>
    </ScrollViewer>
</UserControl>