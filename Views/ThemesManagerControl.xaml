<UserControl x:Class="ArcadeStick.Views.ThemesManagerControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800">
    <!-- The top of the THEME BUILDER tab: a one-line intro, then the Themes Manager row (theme create, load, save and delete only). -->
    <Grid Margin="15,15,15,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- [SECTION: Intro] -->
        <TextBlock Grid.Row="0" Text="Create, load, save or delete a theme here, then pick a layer below to edit it. Edits preview live: Save Adjustments keeps them for next launch, Save Changes writes them into the theme."
                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <!-- [END SECTION: Intro] -->

        <!-- [SECTION: Themes Manager] -->
        <!-- Theme combo (saved themes only) on the left; the Load Theme / New / Save Changes / Delete buttons stay right-aligned. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <!-- MinWidth 83 (the widest header label at the default font) is shared with the Theme sizes and Resolution
                     labels in AdvancedThemesTabControl, so the three rows' controls start at one left edge -->
                <TextBlock Text="Active Theme:" MinWidth="83" Foreground="{DynamicResource Global.Font.SubHeader.Color}" FontSize="{DynamicResource Global.Font.SubHeader.Size}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CboThemePresets" Width="180" Height="25" Style="{StaticResource ChromeComboBoxStyle}"/>
            </StackPanel>

            <!-- Load Theme / New / Save Changes / Delete theme actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="5,0,0,0">
                <Button x:Name="BtnLoadTheme" Content="Load Theme" Width="Auto" Height="Auto"
                    ToolTip="Load the selected theme"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                <Button x:Name="BtnNewTheme" Content="New" Width="Auto" Height="Auto"
                    ToolTip="Create a new theme"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                <Button x:Name="BtnSaveTheme" Content="Save Changes" Width="Auto" Height="Auto"
                    ToolTip="Write your changes into the selected theme's file"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="SemiBold" Padding="7,3" Margin="0,0,5,0"/>
                <Button x:Name="BtnDeleteTheme" Content="Delete" Width="Auto" Height="Auto"
                    ToolTip="Delete the selected theme"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    FontWeight="SemiBold" Padding="7,3"/>
            </StackPanel>
        </Grid>
        <!-- [END SECTION: Themes Manager] -->
    </Grid>
</UserControl>
