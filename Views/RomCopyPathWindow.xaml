<Window x:Class="ArcadeStick.Views.RomCopyPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROM Copy Destination"
        Width="520" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#FF000000">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ROM Copy Destination Folder" FontSize="14" FontWeight="Bold"
                   Foreground="#FFFFFFFF" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DestinationPathTextBox" Grid.Column="0"
                     Background="#FF1C1C1E" Foreground="#FFFFFFFF"
                     BorderBrush="#FF3A3A3C" BorderThickness="1"
                     Padding="6,4" VerticalContentAlignment="Center"
                     FontSize="13" Margin="0,0,8,0"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Padding="12,4"
                    Click="BrowseButton_Click"
                    Background="#FF1C1C1E" Foreground="#FFFFFFFF"
                    BorderBrush="#FF3A3A3C" BorderThickness="1"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Padding="0,4" Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Background="#FF1C1C1E" Foreground="#FFFFFFFF"
                    BorderBrush="#FF3A3A3C" BorderThickness="1"/>
            <Button x:Name="SaveButton" Content="Save" Width="80" Padding="0,4"
                    Click="SaveButton_Click"
                    Background="#FF1C1C1E" Foreground="#FFFFFFFF"
                    BorderBrush="#FF3A3A3C" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</Window>