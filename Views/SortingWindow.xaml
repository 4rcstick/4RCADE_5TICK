<Window x:Class="ArcadeStick.Views.SortingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        Title="4RCADE 5TICK Sorting and Filter Options" Height="610" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Global.Options.Bg}"
        BorderBrush="{StaticResource ChromeBorder}"
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Style="{StaticResource ThemedTabControlStyle}">
            <!-- Same shared Themed Tab Styles as the Options window (App.xaml; Global Tabs and Backgrounds resources). -->

            <!-- [SECTION: Tab Page] -->
            <TabItem Header="SORTING AND FILTER OPTIONS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewer}">
                    <StackPanel Margin="15">

                        <!-- [SECTION: Structure Mode] -->
                        <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="EnableAutoSortCheckBox" Content="Enable Auto Sorting (Built-in Categories)"
                                  IsChecked="{Binding IsCategorySortEnabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}"
                                  FontSize="{DynamicResource Global.Font.Standard.Size}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Keep on for auto-sorting into virtual folders. Turn off to display default folders. "
                                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="11"
                                   TextWrapping="Wrap" Margin="20,0,0,15"/>
                        <!-- [END SECTION: Structure Mode] -->

                        <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Filtering Toggle] -->
                        <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="EnableFiltersCheckBox" Content="Enable Base Filter"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}"
                                  FontSize="{DynamicResource Global.Font.Standard.Size}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Turns on the base filter, which can be further refined below.  Applies to either sorting methods chosen above. Base filter uses a customized bestgames.ini file to remove the junk, including all bootlegs, hacks, and prototypes."
                                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="11"
                                   TextWrapping="Wrap" Margin="20,0,0,15"/>
                        <!-- [END SECTION: Filtering Toggle] -->

                        <!-- [SECTION: Region Row] -->
                        <TextBlock Text="REGION" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                   FontSize="{DynamicResource Global.Font.SubHeader.Size}"
                                   IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"/>
                        <WrapPanel IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}" Margin="0,0,0,15">
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionWorld" Content="World" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionUS" Content="US" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionJapan" Content="Japan" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionAsia" Content="Asia" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionEurope" Content="Europe" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionOther" Content="Other" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkRegionUnspecified" Content="Unspecified" Margin="0,0,15,6"
                                      Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                        </WrapPanel>
                        <!-- [END SECTION: Region Row] -->

                        <!-- [SECTION: Genre Row] -->
                        <TextBlock Text="GENRE" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                   FontSize="{DynamicResource Global.Font.SubHeader.Size}"
                                   IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"/>
                        <Grid IsSharedSizeScope="True" IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol1"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol2"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol4"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="0" Grid.Column="0" x:Name="ChkGenreShooter" Content="Shooter" Margin="0,0,15,6"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="0" Grid.Column="1" x:Name="ChkGenreFighter" Content="Fighter" Margin="0,0,15,6"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="0" Grid.Column="2" x:Name="ChkGenrePlatform" Content="Platform" Margin="0,0,15,6"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="0" Grid.Column="3" x:Name="ChkGenrePuzzle" Content="Puzzle" Margin="0,0,0,6"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>

                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="1" Grid.Column="0" x:Name="ChkGenreSports" Content="Sports" Margin="0,0,15,0"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="1" Grid.Column="1" x:Name="ChkGenreBallPaddle" Content="Ball &amp; Paddle" Margin="0,0,15,0"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="1" Grid.Column="2" x:Name="ChkGenreMaze" Content="Maze" Margin="0,0,15,0"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" Grid.Row="1" Grid.Column="3" x:Name="ChkGenreDriving" Content="Driving"
                                  Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                        </Grid>
                        <!-- [END SECTION: Genre Row] -->

                        <!-- [SECTION: Revisions + Player Count Row] -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="VARIANT TYPE" FontWeight="Bold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                           FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                                <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="IncludeRevisionsCheckBox" Content="Include Revisions"
                                          IsChecked="{Binding SortIncludeRevisions, Mode=TwoWay}"
                                          IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                          Foreground="{DynamicResource Global.Font.Standard.Color}"
                                          FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PLAYER COUNT" FontWeight="Bold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                           FontSize="{DynamicResource Global.Font.SubHeader.Size}"/>
                                <WrapPanel IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}">
                                    <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkPlayers2" Content="2 Player" Margin="0,0,15,6"
                                              Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                                    <CheckBox Style="{StaticResource ChromeCheckBoxStyle}" x:Name="ChkPlayers4" Content="4 Player" Margin="0,0,15,6"
                                              Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="{DynamicResource Global.Font.Standard.Size}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <!-- [END SECTION: Revisions + Player Count Row] -->

                        <!-- [SECTION: Manufacturer] -->
                        <TextBlock Text="MANUFACTURER" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                               FontSize="{DynamicResource Global.Font.SubHeader.Size}"
                               IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"/>
                        <ComboBox x:Name="CmbManufacturer" Height="25" HorizontalAlignment="Left" Width="220" Margin="0,0,0,15"
                              IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                              Style="{StaticResource ChromeComboBoxStyle}">
                            <ComboBoxItem Content="Any" IsSelected="True"/>
                            <ComboBoxItem Content="Atari"/>
                            <ComboBoxItem Content="Bally"/>
                            <ComboBoxItem Content="Capcom"/>
                            <ComboBoxItem Content="Data East"/>
                            <ComboBoxItem Content="Dynax"/>
                            <ComboBoxItem Content="Gaelco"/>
                            <ComboBoxItem Content="Gottlieb"/>
                            <ComboBoxItem Content="Irem"/>
                            <ComboBoxItem Content="Jaleco"/>
                            <ComboBoxItem Content="Kaneko"/>
                            <ComboBoxItem Content="Konami"/>
                            <ComboBoxItem Content="Midway"/>
                            <ComboBoxItem Content="Namco"/>
                            <ComboBoxItem Content="Nichibutsu"/>
                            <ComboBoxItem Content="Nintendo"/>
                            <ComboBoxItem Content="Seibu Kaihatsu"/>
                            <ComboBoxItem Content="Sega"/>
                            <ComboBoxItem Content="SNK"/>
                            <ComboBoxItem Content="Stern"/>
                            <ComboBoxItem Content="Taito"/>
                            <ComboBoxItem Content="Tecmo"/>
                            <ComboBoxItem Content="Williams"/>
                        </ComboBox>
                        <!-- [END SECTION: Manufacturer] -->

                        <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Rating Range Sliders] -->
                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                   FontSize="{DynamicResource Global.Font.SubHeader.Size}">
                            <Run Text="MINIMUM RATING: "/>
                            <Run Text="{Binding Value, ElementName=RatingSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider Style="{StaticResource ChromeSliderStyle}" x:Name="RatingSlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Lower Limit"
                                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                   FontSize="{DynamicResource Global.Font.SubHeader.Size}">
                            <Run Text="MAXIMUM RATING: "/>
                            <Run Text="{Binding Value, ElementName=RatingMaxSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider Style="{StaticResource ChromeSliderStyle}" x:Name="RatingMaxSlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Upper Limit"
                                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <!-- [END SECTION: Rating Range Sliders] -->

                        <Separator Background="{DynamicResource Global.Options.Separator}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Year Range Sliders] -->
                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                   FontSize="{DynamicResource Global.Font.SubHeader.Size}">
                            <Run Text="MINIMUM YEAR: "/>
                            <Run Text="{Binding Value, ElementName=YearMinSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider Style="{StaticResource ChromeSliderStyle}" x:Name="YearMinSlider" Minimum="1970" Maximum="2026" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Lower Limit"
                                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource Global.Font.SubHeader.Color}"
                                   FontSize="{DynamicResource Global.Font.SubHeader.Size}">
                            <Run Text="MAXIMUM YEAR: "/>
                            <Run Text="{Binding Value, ElementName=YearMaxSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider Style="{StaticResource ChromeSliderStyle}" x:Name="YearMaxSlider" Minimum="1970" Maximum="2026" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Upper Limit"
                                   Foreground="{DynamicResource Global.Font.Standard.Color}" FontSize="11"
                                   TextWrapping="Wrap"/>
                        <!-- [END SECTION: Year Range Sliders] -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- [END SECTION: Tab Page] -->
        </TabControl>

        <!-- [SECTION: Apply / Close Button Row] -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Game Pool pill (moved from the main window footer). Hardcoded colors, same dark pill
                 style as the footer pills. Centered in the blank space left of the buttons. Count text
                 is set from code-behind, since this window's DataContext is ConfigurationSettings. -->
            <Border Grid.Column="0" x:Name="GamePoolPill" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#CC000000" BorderBrush="Black" BorderThickness="0" CornerRadius="12" Padding="14,4,14,5">
                <StackPanel>
                    <TextBlock Text="Game Pool" FontSize="10" FontWeight="Bold" Foreground="LightGray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtGamePoolCount" Text="" FontSize="18" FontWeight="Bold" Foreground="LightGray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply Filter" x:Name="BtnApplyFilters" Click="BtnApplyFilters_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        FontWeight="Bold" Padding="15,6" Margin="0,0,10,0"/>
                <Button Content="Close Window" x:Name="BtnCloseSorting" Click="BtnCloseSorting_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Padding="15,6"/>
            </StackPanel>
        </Grid>
        <!-- [END SECTION: Apply / Close Button Row] -->
    </Grid>
</Window>