<Window x:Class="ArcadeStick.Views.SortingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        Title="4RCADE 5TICK Sorting and Filter Options" Height="610" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{Binding BackgroundColor, FallbackValue=#1C1C1E}"
        BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}"
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="{Binding OptionsBg, FallbackValue=#000000}" 
                    BorderBrush="{Binding BorderColorFramework, FallbackValue=#2C2C2E}" 
                    BorderThickness="1" 
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#F2F2F7}">

            <!-- [SECTION: Custom TabControl Template] -->
            <!-- Mirrors OptionsWindow.xaml's template exactly, for visual consistency between the two
                 modal windows. WPF's default TabControl template has internal overlap math that can't be
                 fixed with margin nudges - this fully custom Grid/TabPanel/ContentPresenter layout
                 replaces it entirely. -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Panel.ZIndex="1"
                                  Margin="0"/>

                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <!-- [END SECTION: Custom TabControl Template] -->

            <!-- [SECTION: Custom TabItem Style] -->
            <!-- Themed tab header: normal / hover / selected states, all theme-bound with fallbacks -->
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Height" Value="25"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="{Binding TabFontSize, FallbackValue=12}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" 
                                        Background="{Binding DataContext.OptionsBg, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}" 
                                        BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}" 
                                        BorderThickness="1,1,1,0" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="ContentSite"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="5,2"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.TabHoverColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.TabActiveBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.TabActiveColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#000000}"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.TabBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.TabColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#A0A0A2}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- [END SECTION: Custom TabItem Style] -->

            <!-- [SECTION: Tab Page] -->
            <TabItem Header="SORTING AND FILTER OPTIONS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewer}">
                    <StackPanel Margin="15">

                        <!-- [SECTION: Structure Mode] -->
                        <CheckBox x:Name="EnableAutoSortCheckBox" Content="Enable Auto Sorting (Built-in Categories)"
                                  IsChecked="{Binding IsCategorySortEnabled, Mode=TwoWay}"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}"
                                  FontSize="{Binding StandardFontSize, FallbackValue=13}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Keep on for auto-sorting into virtual folders. Turn off to display default folders. "
                                   Foreground="{Binding StandardColorHex, FallbackValue=#A0A0A2}" FontSize="11"
                                   TextWrapping="Wrap" Margin="20,0,0,15"/>
                        <!-- [END SECTION: Structure Mode] -->

                        <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Filtering Toggle] -->
                        <CheckBox x:Name="EnableFiltersCheckBox" Content="Enable Base Filter"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}"
                                  FontSize="{Binding StandardFontSize, FallbackValue=13}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Turns on the base filter, which can be further refined below.  Applies to either sorting methods chosen above. Base filter uses a customized bestgames.ini file to remove the junk, including all bootlegs, hacks, and prototypes."
                                   Foreground="{Binding StandardColorHex, FallbackValue=#A0A0A2}" FontSize="11"
                                   TextWrapping="Wrap" Margin="20,0,0,15"/>
                        <!-- [END SECTION: Filtering Toggle] -->

                        <!-- [SECTION: Region Row] -->
                        <TextBlock Text="REGION" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"
                                   IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"/>
                        <WrapPanel IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}" Margin="0,0,0,15">
                            <CheckBox x:Name="ChkRegionWorld" Content="World" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox x:Name="ChkRegionUS" Content="US" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox x:Name="ChkRegionJapan" Content="Japan" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox x:Name="ChkRegionAsia" Content="Asia" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox x:Name="ChkRegionEurope" Content="Europe" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox x:Name="ChkRegionOther" Content="Other" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox x:Name="ChkRegionUnspecified" Content="Unspecified" Margin="0,0,15,6"
                                      Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                        </WrapPanel>
                        <!-- [END SECTION: Region Row] -->

                        <!-- [SECTION: Genre Row] -->
                        <TextBlock Text="GENRE" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"
                                   IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"/>
                        <Grid IsSharedSizeScope="True" IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol1"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol2"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol3"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GenreCol4"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkGenreShooter" Content="Shooter" Margin="0,0,15,6"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkGenreFighter" Content="Fighter" Margin="0,0,15,6"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" x:Name="ChkGenrePlatform" Content="Platform" Margin="0,0,15,6"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox Grid.Row="0" Grid.Column="3" x:Name="ChkGenrePuzzle" Content="Puzzle" Margin="0,0,0,6"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>

                            <CheckBox Grid.Row="1" Grid.Column="0" x:Name="ChkGenreSports" Content="Sports" Margin="0,0,15,0"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ChkGenreBallPaddle" Content="Ball &amp; Paddle" Margin="0,0,15,0"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" x:Name="ChkGenreMaze" Content="Maze" Margin="0,0,15,0"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            <CheckBox Grid.Row="1" Grid.Column="3" x:Name="ChkGenreDriving" Content="Driving"
                                  Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                        </Grid>
                        <!-- [END SECTION: Genre Row] -->

                        <!-- [SECTION: Revisions + Player Count Row] -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="VARIANT TYPE" FontWeight="Bold" Margin="0,0,0,6"
                                           Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                           FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                                <CheckBox x:Name="IncludeRevisionsCheckBox" Content="Include Revisions"
                                          IsChecked="{Binding SortIncludeRevisions, Mode=TwoWay}"
                                          IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                          Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}"
                                          FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PLAYER COUNT" FontWeight="Bold" Margin="0,0,0,6"
                                           Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                           FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"/>
                                <WrapPanel IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}">
                                    <CheckBox x:Name="ChkPlayers2" Content="2 Player" Margin="0,0,15,6"
                                              Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                                    <CheckBox x:Name="ChkPlayers4" Content="4 Player" Margin="0,0,15,6"
                                              Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <!-- [END SECTION: Revisions + Player Count Row] -->

                        <!-- [SECTION: Manufacturer] -->
                        <TextBlock Text="MANUFACTURER" FontWeight="Bold" Margin="0,0,0,6"
                               Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                               FontSize="{Binding SubHeaderFontSize, FallbackValue=13}"
                               IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"/>
                        <ComboBox x:Name="CmbManufacturer" Height="25" HorizontalAlignment="Left" Width="220" Margin="0,0,0,15"
                              IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                              Foreground="{Binding BtnTextColorNormalHex, FallbackValue=White}">
                            <ComboBox.Template>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <ToggleButton x:Name="ToggleButton" Focusable="false"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                                        BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"
                                                        BorderThickness="1">
                                                        <Path x:Name="Arrow"
                                                          Fill="{Binding DataContext.BtnTextColorNormalHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                        Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,25,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                            <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <Border x:Name="DropDownBorder"
                                                    Background="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                                    BorderThickness="1"
                                                    BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </ComboBox.Template>
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                    <Setter Property="Foreground" Value="{Binding DataContext.StandardColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                            <Setter Property="Foreground" Value="{Binding DataContext.FolderSelectedColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="Any" IsSelected="True"/>
                            <ComboBoxItem Content="Atari"/>
                            <ComboBoxItem Content="Bally"/>
                            <ComboBoxItem Content="Capcom"/>
                            <ComboBoxItem Content="Data East"/>
                            <ComboBoxItem Content="Dynax"/>
                            <ComboBoxItem Content="Gaelco"/>
                            <ComboBoxItem Content="Gottlieb"/>
                            <ComboBoxItem Content="Irem"/>
                            <ComboBoxItem Content="Jaleco"/>
                            <ComboBoxItem Content="Kaneko"/>
                            <ComboBoxItem Content="Konami"/>
                            <ComboBoxItem Content="Midway"/>
                            <ComboBoxItem Content="Namco"/>
                            <ComboBoxItem Content="Nichibutsu"/>
                            <ComboBoxItem Content="Nintendo"/>
                            <ComboBoxItem Content="Seibu Kaihatsu"/>
                            <ComboBoxItem Content="Sega"/>
                            <ComboBoxItem Content="SNK"/>
                            <ComboBoxItem Content="Stern"/>
                            <ComboBoxItem Content="Taito"/>
                            <ComboBoxItem Content="Tecmo"/>
                            <ComboBoxItem Content="Williams"/>
                        </ComboBox>
                        <!-- [END SECTION: Manufacturer] -->

                        <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Rating Range Sliders] -->
                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding SubHeaderFontSize, FallbackValue=13}">
                            <Run Text="MINIMUM RATING: "/>
                            <Run Text="{Binding Value, ElementName=RatingSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider x:Name="RatingSlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Lower Limit"
                                   Foreground="{Binding StandardColorHex, FallbackValue=#A0A0A2}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding SubHeaderFontSize, FallbackValue=13}">
                            <Run Text="MAXIMUM RATING: "/>
                            <Run Text="{Binding Value, ElementName=RatingMaxSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider x:Name="RatingMaxSlider" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Upper Limit"
                                   Foreground="{Binding StandardColorHex, FallbackValue=#A0A0A2}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <!-- [END SECTION: Rating Range Sliders] -->

                        <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Year Range Sliders] -->
                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding SubHeaderFontSize, FallbackValue=13}">
                            <Run Text="MINIMUM YEAR: "/>
                            <Run Text="{Binding Value, ElementName=YearMinSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider x:Name="YearMinSlider" Minimum="1970" Maximum="2026" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Lower Limit"
                                   Foreground="{Binding StandardColorHex, FallbackValue=#A0A0A2}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding SubHeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding SubHeaderFontSize, FallbackValue=13}">
                            <Run Text="MAXIMUM YEAR: "/>
                            <Run Text="{Binding Value, ElementName=YearMaxSlider, Mode=OneWay}"/>
                        </TextBlock>
                        <Slider x:Name="YearMaxSlider" Minimum="1970" Maximum="2026" TickFrequency="1" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding IsChecked, ElementName=EnableFiltersCheckBox}"
                                Margin="0,0,0,4"/>
                        <TextBlock Text="Sets the Upper Limit"
                                   Foreground="{Binding StandardColorHex, FallbackValue=#A0A0A2}" FontSize="11"
                                   TextWrapping="Wrap"/>
                        <!-- [END SECTION: Year Range Sliders] -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- [END SECTION: Tab Page] -->
        </TabControl>

        <!-- [SECTION: Apply / Close Button Row] -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Apply Filter" x:Name="BtnApplyFilters" Click="BtnApplyFilters_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                    BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                    BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="Bold" Padding="15,6" Margin="0,0,10,0"/>
            <Button Content="Close Window" x:Name="BtnCloseSorting" Click="BtnCloseSorting_Click"
                    Style="{StaticResource ThemedActionButtonStyle}"
                    Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#F2F2F7}"
                    BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#3A3A3C}"
                    BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" Padding="15,6"/>
        </StackPanel>
        <!-- [END SECTION: Apply / Close Button Row] -->
    </Grid>
</Window>