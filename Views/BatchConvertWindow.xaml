<Window x:Class="ArcadeStick.Views.BatchConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        Title="4RCADE 5TICK Batch Video Conversion" Height="555" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{Binding BackgroundColor, FallbackValue=#1C1C1E}"
        BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}"
        BorderThickness="1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="{Binding OptionsBg, FallbackValue=#000000}" 
                    BorderBrush="{Binding BorderColorFramework, FallbackValue=#2C2C2E}" 
                    BorderThickness="1" 
                    Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#F2F2F7}">

            <!-- [SECTION: Custom TabControl Template] -->
            <!-- Same template as SortingWindow/OptionsWindow, for visual consistency between the modal windows. -->
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Panel.ZIndex="1"
                                  Margin="0"/>

                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <!-- [END SECTION: Custom TabControl Template] -->

            <!-- [SECTION: Custom TabItem Style] -->
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Height" Value="25"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="{Binding TabFontSize, FallbackValue=12}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" 
                                        Background="{Binding DataContext.OptionsBg, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}" 
                                        BorderBrush="{Binding DataContext.BorderColorFramework, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}" 
                                        BorderThickness="1,1,1,0" 
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="ContentSite"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="5,2"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.BtnBgColorHoverHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#2C2C2E}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.TabHoverColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.TabActiveBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.TabActiveColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#000000}"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{Binding DataContext.TabBgColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        <Setter Property="Foreground" Value="{Binding DataContext.TabColorHex, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#A0A0A2}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- [END SECTION: Custom TabItem Style] -->

            <!-- [SECTION: Tab Page] -->
            <TabItem Header="BATCH VIDEO CONVERSION">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ArcadeDarkScrollViewer}">
                    <StackPanel Margin="15">

                        <!-- [SECTION: Info Text] -->
                        <TextBlock Text="WHAT THIS DOES" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding HeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding HeaderFontSize, FallbackValue=14}"/>
                        <TextBlock Text="These videos can't be played by the launcher's video player, so their games are showing artwork instead. Converting re-encodes each one into a compatible format (H.264 video, AAC audio)."
                                   Foreground="{Binding SubTextColorHex, FallbackValue=#A0A0A2}"
                                   FontSize="{Binding SubTextFontSize, FallbackValue=12}"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock Text="YOUR ORIGINALS ARE SAFE" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding HeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding HeaderFontSize, FallbackValue=14}"/>
                        <TextBlock Text="Nothing is deleted. Each original file is moved into an &quot;originals&quot; folder inside your videos folder, but only after its converted version is ready. If a conversion fails, the original stays exactly where it was."
                                   Foreground="{Binding SubTextColorHex, FallbackValue=#A0A0A2}"
                                   FontSize="{Binding SubTextFontSize, FallbackValue=12}"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <TextBlock Text="HOW LONG WILL IT TAKE?" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding HeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding HeaderFontSize, FallbackValue=14}"/>
                        <TextBlock Text="Each video takes a little while, depending on its length and your computer. You can cancel at any time - the video being converted at that moment is left untouched."
                                   Foreground="{Binding SubTextColorHex, FallbackValue=#A0A0A2}"
                                   FontSize="{Binding SubTextFontSize, FallbackValue=12}"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <!-- [END SECTION: Info Text] -->

                        <Separator Background="{Binding SeparatorColorHex, FallbackValue=#2C2C2E}" Margin="0,0,0,15"/>

                        <!-- [SECTION: Progress] -->
                        <TextBlock Text="PROGRESS" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{Binding HeaderColorHex, FallbackValue=#00D4FF}"
                                   FontSize="{Binding HeaderFontSize, FallbackValue=14}"/>
                        <ProgressBar x:Name="ConversionProgress" Height="14" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,6"
                                     Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                                     Foreground="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                                     BorderBrush="{Binding BorderColorFramework, FallbackValue=#3A3A3C}"/>
                        <TextBlock x:Name="TxtCurrentFile" Text="" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"
                                   Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}"
                                   FontSize="{Binding StandardFontSize, FallbackValue=13}"/>
                        <TextBlock x:Name="TxtResult" Text="" TextWrapping="Wrap"
                                   Foreground="{Binding StandardColorHex, FallbackValue=#F2F2F7}" FontSize="11"/>
                        <!-- [END SECTION: Progress] -->
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- [END SECTION: Tab Page] -->
        </TabControl>

        <!-- [SECTION: Start / Close Button Row] -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- "To Convert" count pill - same dark pill as the Sorting window's Game Pool pill. Hardcoded
                 colors, count text set from code-behind since this window's DataContext is ConfigurationSettings. -->
            <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#CC000000" BorderBrush="Black" BorderThickness="0" CornerRadius="12" Padding="14,4,14,5">
                <StackPanel>
                    <TextBlock Text="To Convert" FontSize="10" FontWeight="Bold" Foreground="LightGray" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtToConvertCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="LightGray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start Conversion" x:Name="BtnStart" Click="BtnStart_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#00D4FF}"
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#00D4FF}"
                        BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" FontWeight="Bold" Padding="15,6" Margin="0,0,10,0"/>
                <Button Content="Close Window" x:Name="BtnClose" Click="BtnClose_Click"
                        Style="{StaticResource ThemedActionButtonStyle}"
                        Background="{Binding BtnBgColorHex, FallbackValue=#1C1C1E}"
                        Foreground="{Binding BtnTextColorNormalHex, FallbackValue=#F2F2F7}"
                        BorderBrush="{Binding BtnBorderColorHex, FallbackValue=#3A3A3C}"
                        BorderThickness="{Binding OptionsBtnBorderSize, FallbackValue=1}" Padding="15,6"/>
            </StackPanel>
        </Grid>
        <!-- [END SECTION: Start / Close Button Row] -->
    </Grid>
</Window>