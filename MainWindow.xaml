<Window x:Class="ArcadeStick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArcadeStick"
        xmlns:views="clr-namespace:ArcadeStick.Views"
        mc:Ignorable="d"
        xmlns:ViewModels="clr-namespace:ArcadeStick.ViewModels"
        xmlns:Models="clr-namespace:ArcadeStick.Models"
        xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker"
        Title="4RCADE 5TICK" 
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Background menu for right-clicking empty space in the game tree (below the last row, or any
             area not covered by a folder/game row's own ContextMenu). Defined here at the Window level
             rather than inside TreeView.Resources, since an element's ContextMenu attribute is evaluated
             before that same element's own child .Resources content is parsed - a self-reference would
             fail to resolve. Row-level ContextMenus still take priority when clicking directly on a row,
             since they're closer ancestors in the visual tree. -->
        <!-- Reused button-role colors (same pattern as Sort/Options), but via a full custom
             ControlTemplate rather than plain property setters - MenuItem's default OS-themed chrome
             paints its background/foreground through internal template parts that ignore simple
             Background/Foreground setters, same reason ThemedActionButtonStyle needed a full template
             instead of just setting Button.Background. Keyless (implicit) so it cascades to nested
             submenu items too (Move's Up/Down/Top/Bottom, the dynamic Favorites/folder entries). -->
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <!-- Bound to MainViewModel's ThemeX forwarder properties (not raw Configuration.X) -
                             ConfigurationSettings doesn't implement INotifyPropertyChanged, so a binding
                             straight to Configuration.X only ever evaluates once and never updates after a
                             theme loads/saves. The ThemeX forwarders do get explicitly refreshed via
                             RefreshThemeBindings(), which is the mechanism every other themed element in
                             this app already relies on. -->
                        <Border x:Name="ItemBorder" Background="{Binding DataContext.ThemeContextMenuBgColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconPresenter" Grid.Column="0" ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{Binding DataContext.ThemeContextMenuIconColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"/>
                                <ContentPresenter x:Name="HeaderPresenter" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0"
                                                  TextElement.Foreground="{Binding DataContext.ThemeContextMenuFontColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                                <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{Binding DataContext.ThemeContextMenuIconColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#00D4FF}"
                                      StrokeThickness="1.3" VerticalAlignment="Center" Margin="8,0,4,0" Visibility="Collapsed"/>
                                <Popup x:Name="SubmenuPopup" Grid.Column="0" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False">
                                    <Border Background="{Binding DataContext.ThemeContextMenuBgColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"
                                            BorderBrush="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}" BorderThickness="1">
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{Binding DataContext.ThemeContextMenuHoverBgColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#EF44C3}"/>
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{Binding DataContext.ThemeContextMenuHoverColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                                <Setter TargetName="IconPresenter" Property="TextElement.Foreground" Value="{Binding DataContext.ThemeContextMenuHoverColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#F2F2F7}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- Dim only the content (icon + text), not the Border's own background -
                                     dimming the Border itself (which carries the seamless fill matching
                                     ContextMenu's own background) created a visible rectangle seam instead. -->
                                <Setter TargetName="HeaderPresenter" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{Binding ThemeContextMenuBgColor, FallbackValue=#1C1C1E}"/>
            <Setter Property="BorderBrush" Value="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border BorderBrush="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}" BorderThickness="0,1,0,0" Margin="34,4,4,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TreeViewBackgroundContextMenu">
            <MenuItem Header="Create folder" Click="CreateFolderMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Main hamburger menu: opened from code-behind (BtnOpenMenuHamburger click), anchored under the button. -->
        <ContextMenu x:Key="HamburgerContextMenu" Placement="Bottom" Closed="HamburgerContextMenu_Closed">
            <MenuItem Header="Sorting Options" Click="HamburgerSortingMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xEADF;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Options Menu" Click="HamburgerOptionsMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Theme Builder" InputGestureText="Ctrl+T" Click="HamburgerThemeBuilderMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Themes" Tag="ThemesMenu">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
                <MenuItem Header="(loading...)"/>
            </MenuItem>
            <MenuItem Header="Layout size" Tag="LayoutSizeMenu">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
                <MenuItem Header="(loading...)"/>
            </MenuItem>
            <MenuItem Header="Toggle Fullscreen" Click="HamburgerFullscreenMenuItem_Click">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <!-- [SECTION: Root Grid Background Style] -->
        <!-- Wallpaper image if set, else falls back to ThemeMainColor solid fill -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background">
                    <Setter.Value>
                        <ImageBrush ImageSource="{Binding ThemeMainWallpaper}" Stretch="UniformToFill"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ThemeMainWallpaper}" Value="{x:Null}">
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="{Binding ThemeMainColor, FallbackValue=#1C1C1E}"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <!-- [END SECTION: Root Grid Background Style] -->

        <!-- [SECTION: Main Background Video] -->
        <!-- MediaElement - renders as a normal WPF element, so it respects z-order and sits behind
             every panel declared after it. First child + full row/column span = bottom layer above the root
             Grid's Background. Source/playback/looping are driven entirely from code-behind (RefreshMainBgVideo),
             so LoadedBehavior/UnloadedBehavior are Manual. Always muted - background videos don't carry sound. -->
        <Canvas x:Name="MainBgVideoHost" ClipToBounds="True" IsHitTestVisible="False">
            <MediaElement x:Name="MainBgVideo" Width="{Binding ActualWidth, ElementName=MainBgVideoHost}" Height="{Binding ActualHeight, ElementName=MainBgVideoHost}" Stretch="UniformToFill" IsMuted="True"
                 LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Visibility="Collapsed" IsHitTestVisible="False"
                 MediaEnded="MainBgVideo_MediaEnded" MediaFailed="MainBgVideo_MediaFailed"/>
        </Canvas>
        <!-- [END SECTION: Main Background Video] -->

        <!-- [SECTION: Left Column - Search + Game TreeView] -->
        <!-- Fixed-size layout surface, anchored top-left. Width/Height here are the 1280x720 defaults;
             ApplyLayout() in code-behind sets them (and every child's position, size, Z and visibility)
             from the active layout. The root Grid behind it fills the rest of the window with the
             wallpaper/background color. -->
        <Canvas x:Name="LayoutCanvas" Width="1280" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- Search label + textbox + buttons: each is its own positioned layer now -->
            <!-- Search label: the outer Border is the positioned layer and holds the fill; the inner TextBlock is the text.
                 The vertical nudge is a RenderTransform on the text only, so it never changes layout: the fill, size and
                 position stay put and 0 looks exactly like the old single TextBlock. The text stretches to fill the
                 Border so the padding and alignment place it as before. Not clipped, like the drop shadow. -->
            <Border x:Name="SearchLabel" Canvas.Left="20" Canvas.Top="20" Width="67" Height="30" Background="{Binding ThemeSearchLabelBgColor, FallbackValue=#00000000}">
                <TextBlock x:Name="SearchLabelText" TextAlignment="{Binding ThemeSearchLabelTextAlignment, FallbackValue=Right}" Text="SEARCH:" Foreground="{Binding ThemeSearchLabelColor, FallbackValue=#00D4FF}" Padding="4,6,4,6" FontFamily="{Binding ThemeSearchLabelFontFamily, FallbackValue=Segoe UI}" FontWeight="{Binding ThemeSearchLabelFontWeight, FallbackValue=DemiBold}" Effect="{Binding ThemeSearchLabelEffect}" FontSize="{Binding ThemeSearchLabelFontSize, FallbackValue=13}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="{Binding ThemeSearchLabelTextNudgeY, FallbackValue=0}"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Border>
            <TextBox x:Name="SearchBox" Canvas.Left="87" Canvas.Top="20" Width="142" Height="30" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{Binding ThemeSearchBoxBgColor, FallbackValue=#000000}" Foreground="{Binding ThemeSearchBoxColor, FallbackValue=#F2F2F7}" FontSize="{Binding ThemeSearchBoxFontSize, FallbackValue=13}" FontWeight="DemiBold" BorderBrush="{Binding ThemeMainWinBtnBorderColor, FallbackValue=Black}" BorderThickness="{Binding ThemeMainWinBtnBorderSize, FallbackValue=1}" Padding="2,0,0,1">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <!-- Play Random Game trigger - opens a small confirm flyout anchored here before spinning -->
            <Border x:Name="BtnPlayRandom" Canvas.Left="235" Canvas.Top="20" Width="30" Height="30" CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}"
                        Cursor="Hand" MouseLeftButtonUp="BtnPlayRandom_MouseLeftButtonUp"
                        ToolTipService.IsEnabled="False" MouseEnter="MainButton_MouseEnter" MouseLeave="MainButton_MouseLeave">
                <Border.ToolTip>
                    <ToolTip Content="Random Game"/>
                </Border.ToolTip>
                <!-- Border ring: the outer Border above holds the fill out to the full rounded edge, this inner one draws the border on top, so no sliver of the background behind shows at the corners. -->
                <Border CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}" IsHitTestVisible="False"
                            BorderBrush="{Binding ThemeMainWinBtnBorderColor, FallbackValue=Black}" BorderThickness="{Binding ThemeMainWinBtnBorderSize, FallbackValue=1}">
                    <TextBlock x:Name="PlayRandomIcon" Text="&#x1F3B2;" FontFamily="Segoe UI Emoji" FontSize="{Binding ThemeMainWinBtnFontSize, FallbackValue=13}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Border>
            <!-- Opens the Sorting window (structure mode + region/revision/player-count/rating filters) -->
            <Border x:Name="BtnOpenSortingGear" Canvas.Left="271" Canvas.Top="20" Width="30" Height="30" CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}"
                        Cursor="Hand" MouseLeftButtonUp="BtnOpenSortingGear_MouseLeftButtonUp"
                        ToolTipService.IsEnabled="False" MouseEnter="MainButton_MouseEnter" MouseLeave="MainButton_MouseLeave">
                <Border.ToolTip>
                    <ToolTip Content="Sorting Options"/>
                </Border.ToolTip>
                <Border CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}" IsHitTestVisible="False"
                            BorderBrush="{Binding ThemeMainWinBtnBorderColor, FallbackValue=Black}" BorderThickness="{Binding ThemeMainWinBtnBorderSize, FallbackValue=1}">
                    <TextBlock x:Name="SortGearIcon" Text="&#xEADF;" FontFamily="Segoe MDL2 Assets" FontSize="{Binding ThemeMainWinBtnFontSize, FallbackValue=13}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Border>
            <!-- Gear icon that opens the Options window, isolated in its own circular badge -->
            <Border x:Name="BtnOpenOptionsGear" Canvas.Left="307" Canvas.Top="20" Width="30" Height="30" CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}"
                        Cursor="Hand" MouseLeftButtonUp="BtnOpenOptionsGear_MouseLeftButtonUp"
                        ToolTipService.IsEnabled="False" MouseEnter="MainButton_MouseEnter" MouseLeave="MainButton_MouseLeave">
                <Border.ToolTip>
                    <ToolTip Content="Options Menu"/>
                </Border.ToolTip>
                <Border CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}" IsHitTestVisible="False"
                            BorderBrush="{Binding ThemeMainWinBtnBorderColor, FallbackValue=Black}" BorderThickness="{Binding ThemeMainWinBtnBorderSize, FallbackValue=1}">
                    <TextBlock x:Name="OptionsGearIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="{Binding ThemeMainWinBtnFontSize, FallbackValue=13}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Border>
            <!-- Hamburger icon that opens the main menu popup (Sorting Options, Options Menu, Toggle Fullscreen) -->
            <Border x:Name="BtnOpenMenuHamburger" Canvas.Left="343" Canvas.Top="20" Width="30" Height="30" CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}"
                        Cursor="Hand" MouseLeftButtonUp="BtnOpenMenuHamburger_MouseLeftButtonUp"
                        ToolTipService.IsEnabled="False" MouseEnter="MainButton_MouseEnter" MouseLeave="MainButton_MouseLeave">
                <Border.ToolTip>
                    <ToolTip Content="Menu"/>
                </Border.ToolTip>
                <Border CornerRadius="{Binding ThemeMainWinBtnCornerRadius, FallbackValue=0}" IsHitTestVisible="False"
                            BorderBrush="{Binding ThemeMainWinBtnBorderColor, FallbackValue=Black}" BorderThickness="{Binding ThemeMainWinBtnBorderSize, FallbackValue=1}">
                    <TextBlock x:Name="HamburgerIcon" Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="{Binding ThemeMainWinBtnFontSize, FallbackValue=13}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Border>
            </Border>


            <!-- Shape layers 01 to 04: background/border layers. Fill, border, corner radius, visibility and the image or
     video (stretched to fill, shown inside the host Grid) are all set from the layer entry in ApplyLayout(). -->
            <Border x:Name="ShapeLayer01" IsHitTestVisible="False" Canvas.Left="20" Canvas.Top="60" Width="353" Height="640" ClipToBounds="True">
                <Grid x:Name="ShapeLayer01Host"/>
            </Border>
            <Border x:Name="ShapeLayer02" IsHitTestVisible="False" Canvas.Left="393" Canvas.Top="177" Width="867" Height="523" ClipToBounds="True">
                <Grid x:Name="ShapeLayer02Host"/>
            </Border>
            <Border x:Name="ShapeLayer03" IsHitTestVisible="False" Canvas.Left="393" Canvas.Top="20" Width="867" Height="137" ClipToBounds="True">
                <Grid x:Name="ShapeLayer03Host"/>
            </Border>
            <Border x:Name="ShapeLayer04" IsHitTestVisible="False" Canvas.Left="393" Canvas.Top="177" Width="867" Height="523" ClipToBounds="True" Visibility="Collapsed">
                <Grid x:Name="ShapeLayer04Host"/>
            </Border>

            <!-- Games List layer: its own positioned element above the BG. The TreeView and everything
                 inside it (templates, context menus, handlers) are unchanged. -->
            <Grid x:Name="GamesListHost" Canvas.Left="25" Canvas.Top="70" Width="343" Height="625">
                <TreeView x:Name="GameTree" 
                   ItemsSource="{Binding TreeNodesCollection}"
                   SelectedItemChanged="GameTree_SelectedItemChanged"
                   Background="Transparent" BorderThickness="0" Padding="5" Margin="0"
                   TreeViewItem.Expanded="GameTree_Expanded"
                   TreeViewItem.Collapsed="GameTree_Collapsed"
                   PreviewMouseDoubleClick="GameTree_MouseDoubleClick"
                   ContextMenu="{StaticResource TreeViewBackgroundContextMenu}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   VirtualizingPanel.ScrollUnit="Pixel">

                    <TreeView.Resources>
                        <!-- [SECTION: TreeView Scrollbar Template] -->
                        <!-- TreeView's internal ScrollViewer (part of WPF's built-in TreeView template) can't be targeted
         by name, so this implicit BasedOn style is what actually applies the shared template here - do
         not remove, GameTree's scrollbar will silently revert to default without it. ArcadeDarkScrollBarThemed/
         ArcadeDarkScrollViewerThemed now live in App.xaml (Application.Resources) so both GameTree and
         MediaPanelControl can reach them via StaticResource - see App.xaml. -->
                        <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource ArcadeDarkScrollViewerThemed}"/>

                        <!-- [SECTION: TreeView Folder/Game DataTemplates] -->

                        <!-- [SECTION: Row Context Menus] -->
                        <!-- Folder-row menu: Stage 1 ships all items as disabled placeholders. Stage 2
                             (Create/Rename/Color/Delete) and Stage 3 (Move submenu) will flip IsEnabled
                             and wire Click handlers onto this same menu without needing to re-wire the
                             right-click plumbing itself. -->
                        <ContextMenu x:Key="FolderRowContextMenu" Opened="FolderRowContextMenu_Opened">
                            <MenuItem Header="Create folder" Click="CreateFolderMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Rename folder" Click="RenameFolderMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8AC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Choose folder color" Click="ChooseFolderColorMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete folder" Click="DeleteFolderMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ClearFolderMenuItem" Header="Clear Folder" Click="ClearFolderMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE738;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ClearAllPlayHistoryMenuItem" Header="Clear All Play History" Click="ClearAllPlayHistoryMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem x:Name="MoveFolderMenuItem" Header="Move">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                                <MenuItem Header="Move to Top" Click="MoveFolderToTop_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Move Up 1" Click="MoveFolderUp_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Move Down 1" Click="MoveFolderDown_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Move to Bottom" Click="MoveFolderToBottom_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </ContextMenu>

                        <!-- Game-row menu: "Add to Folder" submenu is populated dynamically in code-behind
                             on SubmenuOpened. "Remove from Folder" enabled state is set in code-behind on
                             ContextMenuOpening, based on which node the row is actually being viewed under. -->
                        <ContextMenu x:Key="GameRowContextMenu" Opened="GameRowContextMenu_Opened">
                            <MenuItem x:Name="AddToFolderMenuItem" Header="Add to Folder" SubmenuOpened="AddToFolderMenuItem_SubmenuOpened">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                                <MenuItem Header="(loading...)"/>
                            </MenuItem>
                            <MenuItem x:Name="RemoveFromFolderMenuItem" Header="Remove from Folder" Click="RemoveFromFolderMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE738;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            
                            <MenuItem Header="Toggle Mouse Support" Click="ToggleRawMouseMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE962;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Add to ROM exclusion list" Click="AddToExclusionListMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Header="Get Artwork" Click="GetArtworkMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                        <!-- [END SECTION: Row Context Menus] -->

                        <!-- Category/folder row template (e.g. SHOOTERS, FIGHTERS) -->
                        <HierarchicalDataTemplate DataType="{x:Type Models:TreeCategoryNode}" ItemsSource="{Binding DisplayItems}">
                            <Border x:Name="FolderRowBorder" Background="Transparent" HorizontalAlignment="Stretch" Margin="-3,0,0,0" Padding="0,0,0,2" ContextMenu="{StaticResource FolderRowContextMenu}" PreviewMouseRightButtonDown="FolderRowBorder_PreviewMouseRightButtonDown">
                                <Grid VerticalAlignment="Center" Margin="0,0,0,0">
                                    <!-- Real text, rendered on top -->
                                    <TextBlock x:Name="FolderHeaderText" Text="{Binding HeaderText}" Foreground="{Binding FolderColor}" FontFamily="{Binding FolderFontFamily}" FontWeight="{Binding FolderFontWeight}" Effect="{Binding FolderTextEffect}" FontSize="{Binding FolderFontSize, FallbackValue=16}" VerticalAlignment="Center" Padding="3,0,0,0" Margin="0,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <HierarchicalDataTemplate.Triggers>
                                <!-- Selected folder row: swap background + text color -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="FolderRowBorder" Property="Background" Value="{Binding FolderSelectedBgColor, FallbackValue=#2C2C2E}"/>
                                    <Setter TargetName="FolderHeaderText" Property="Foreground" Value="{Binding FolderSelectedColor, FallbackValue=#00D4FF}"/>
                                </DataTrigger>

                                <!-- Selected row: use the selected-state shadow (off by default; set in the Theme Builder's Folders tab). -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="FolderHeaderText" Property="Effect" Value="{Binding FolderSelectedTextEffect}"/>
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>

                        <!-- Individual game row template (leaf nodes) -->
                        <DataTemplate DataType="{x:Type Models:GameItem}">
                            <Border x:Name="GameRowBorder" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="-12,0,0,0" Padding="4,0,0,2" ContextMenu="{StaticResource GameRowContextMenu}" PreviewMouseRightButtonDown="GameRowBorder_PreviewMouseRightButtonDown">
                                <Grid VerticalAlignment="Top" Height="AUto" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Mouse-support glyph, only shown when IsMouseSupported is true -->
                                    <TextBlock x:Name="MouseGlyph" Grid.Column="0" Text="&#8226;" Foreground="{Binding GameColor, FallbackValue=#F2F2F7}" FontFamily="{Binding GameFontFamily}" FontWeight="{Binding GameFontWeight}" Effect="{Binding GameTextEffect}" FontSize="{Binding FontSize, FallbackValue=14}" Width="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" Visibility="Collapsed"/>

                                    <TextBlock x:Name="GameTitleText" Grid.Column="1" Text="{Binding DisplayTitle}" Foreground="{Binding GameColor, FallbackValue=#F2F2F7}" FontFamily="{Binding GameFontFamily}" FontWeight="{Binding GameFontWeight}" Effect="{Binding GameTextEffect}" FontSize="{Binding FontSize, FallbackValue=14}" Padding="2,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseSupported}" Value="True">
                                    <Setter TargetName="MouseGlyph" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- Hover state -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsMouseOver}" Value="True">
                                    <Setter TargetName="GameTitleText" Property="Foreground" Value="{Binding GameHoverColor, FallbackValue=#FFFFFF}"/>
                                    <Setter TargetName="MouseGlyph" Property="Foreground" Value="{Binding GameHoverColor, FallbackValue=#FFFFFF}"/>
                                </DataTrigger>
                                <!-- Selected state: swap row background + text color -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="GameRowBorder" Property="Background" Value="{Binding GameSelectedBgColor, FallbackValue=#2C2C2E}"/>
                                    <Setter TargetName="GameTitleText" Property="Foreground" Value="{Binding GameSelectedColor, FallbackValue=#00D4FF}"/>
                                    <Setter TargetName="MouseGlyph" Property="Foreground" Value="{Binding GameSelectedColor, FallbackValue=#00D4FF}"/>
                                </DataTrigger>

                                <!-- Selected row: use the selected-state shadow (off by default; set in the Theme Builder's Game Titles tab). -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="GameTitleText" Property="Effect" Value="{Binding GameSelectedTextEffect}"/>
                                    <Setter TargetName="MouseGlyph" Property="Effect" Value="{Binding GameSelectedTextEffect}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                        <!-- [END SECTION: TreeView Folder/Game DataTemplates] -->
                    </TreeView.Resources>

                    <!-- [SECTION: TreeViewItem Expander Template] -->
                    <!-- Custom TreeViewItem template: expand/collapse arrow + header + child items host -->
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsNodeExpanded, Mode=OneWay}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Expand/collapse toggle arrow -->
                                                <ToggleButton x:Name="Expander"
                                                              Grid.Column="0"
                                                              Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsNodeExpanded, Mode=TwoWay}"
                                                              ClickMode="Press">
                                                    <ToggleButton.Style>
                                                        <Style TargetType="ToggleButton">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <!-- Arrows -->
                                                                        <Border Background="Transparent" Width="16" Height="16" Padding="0,1,0,1">
                                                                            <Path x:Name="ExpandArrow"
                                                                            Data="M 0 0 L 6 4 L 0 8 Z"
                                                                            Effect="{Binding FolderTextEffect}"
                                                                            Fill="{Binding ArrowColor, FallbackValue=#A0A0A2}"
                                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Margin="{Binding ArrowMargin}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <!-- Rotate arrow shape (right-pointing to down-pointing) when expanded -->
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="ExpandArrow" Property="Data" Value="M 0 0 L 8 0 L 4 6 Z"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ToggleButton.Style>
                                                </ToggleButton>

                                                <!-- Row header content (folder name or game title, from the DataTemplates above) -->
                                                <ContentPresenter x:Name="PART_Header"
                                                                  Grid.Column="1"
                                                                  ContentSource="Header"
                                                                  HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <!-- Child items (nested categories/games), hidden until expanded -->
                                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0" Visibility="Collapsed"/>
                                        </StackPanel>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <!-- Hide arrow entirely for leaf nodes with no children -->
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <!-- [END SECTION: TreeViewItem Expander Template] -->
                </TreeView>
            </Grid>
            <!-- [END SECTION: Left Column - Search + Game TreeView] -->

            <!-- [SECTION: Right Column - Marquee + Media Panels] -->
            <!-- Marquee and media panel are positioned layers on the LayoutCanvas now -->

            <!-- ROW 0: MARQUEE / LOGO PANEL -->
            <!-- Shows the theme logo asset by default, swaps to the game's marquee image once a game is selected -->
            <Border x:Name="MarqueePanelBorder" Canvas.Left="393" Canvas.Top="20" Width="867" Height="137">
                <Grid>
                    <!-- Default logo, hidden once a game is selected -->
                    <Image Source="{Binding ThemeLogoAsset}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRandomizerOverlayActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <!-- Selected game's marquee image -->
                    <Image x:Name="MarqueeDisplay" Source="{Binding MarqueeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRandomizerOverlayActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <!-- No-art banner: shown when the selected game has no marquee file (and no spin is running).
     Same ~4:1 card as the spin's no-marquee fallback below, so it letterboxes the same way. -->
                    <Viewbox x:Name="NoMarqueeBanner" Stretch="Uniform">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding MarqueeMissing}" Value="True"/>
                                            <Condition Binding="{Binding IsRandomizerOverlayActive}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Border Width="400" Height="100" Background="{Binding ThemeMainColor, FallbackValue=#1C1C1E}" BorderBrush="{Binding ThemeHeaderColor, FallbackValue=#EF44C3}" BorderThickness="2">
                            <TextBlock Text="{Binding SelectedGame.DisplayTitle}" FontSize="30" FontWeight="Bold" Foreground="{Binding ThemeHeaderColor, FallbackValue=#EF44C3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Viewbox>

                    <!-- Play Random Game spin overlay - sits on top of the logo/MarqueeDisplay above and only shows during
             a spin. The layer is transparent now (background and border come from separate layers), so the logo
             and the selected marquee are collapsed above while the overlay is active, which keeps them from
             showing underneath. Same Stretch as MarqueeDisplay, no margins. -->
                    <Border x:Name="RandomizerSpinMarqueeOverlay">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRandomizerOverlayActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Winner blink: hides the whole frame (marquee image or no-marquee title card) during the
                     blink's "off" steps. -->
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRandomizerBlinkHidden}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Image x:Name="RandomizerSpinMarqueeImage" Source="{Binding RandomizerFrameMarqueeImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- No-marquee fallback - shown whenever the current frame's game has no real marquee file.
                     A fixed-aspect card (~4:1) inside a Viewbox, so it letterboxes like a real marquee image.
                     Card colors reuse ThemeMainColor/ThemeHeaderColor, which always contrast by design. -->
                            <Border x:Name="RandomizerNoMarqueeFallback">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RandomizerFrameHasMarquee}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Stretch="Uniform">
                                    <Border Width="400" Height="100" Background="{Binding ThemeMainColor, FallbackValue=#1C1C1E}" BorderBrush="{Binding ThemeHeaderColor, FallbackValue=#EF44C3}" BorderThickness="2">
                                        <TextBlock Text="{Binding RandomizerCurrentFrameGame.DisplayTitle}" FontSize="30" FontWeight="Bold" Foreground="{Binding ThemeHeaderColor, FallbackValue=#EF44C3}" TextAlignment="Center" TextWrapping="Wrap" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>



            <!-- ROW 1: THE RIGHT SIDE MAIN MEDIA PANEL CONTAINER -->
            <!-- Extracted into its own UserControl (MediaPanelControl) - content/bindings unchanged from
                 before, just relocated so the upcoming redesign happens in isolation. VideoPreview and
                 MediaLayer0_Back are exposed as public fields on the control for MainWindow.xaml.cs's
                 existing call sites (see MediaPanel.VideoPreview / MediaPanel.MediaLayer0_Back below). -->
            
            <!-- Splash Image layer: its own positioned element, mapped in ApplyLayout() -->
            <views:SplashLayerControl x:Name="SplashLayer" Canvas.Left="393" Canvas.Top="177" Width="867" Height="523"/>

            <!-- Video Preview layer: its own positioned element, mapped in ApplyLayout() -->
            <views:VideoPreviewLayerControl x:Name="VideoPreviewLayer" Canvas.Left="414" Canvas.Top="198" Width="328" Height="248"/>

            <!-- Game Info layer group: a transparent host filling the canvas, holding six independently
                 positioned parts (title, publisher block, info nav, info, previews nav, previews). Each part is
                 mapped in ApplyLayout(); the host takes the group's shared Z. -->
            <views:GameInfoLayerControl x:Name="GameInfoLayer" Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720"/>

            <!-- Random Game Display layer: its own positioned element, mapped in ApplyLayout(). The outer host is
                 what ApplyLayout shows/hides; the inner grid shows only while a spin runs (DataTrigger). With no
                 file set on the layer, the fallback shows the media-color fill and "Rolling the Dice!" text
                 (scaled to the layer by the Viewbox). With a file set, code-behind collapses the fallback and
                 plays the file in RandomSpinFileHost instead - the file shows alone, no fill. -->
            <Grid x:Name="RandomGameDisplayLayer" IsHitTestVisible="False" Canvas.Left="393" Canvas.Top="177" Width="867" Height="523" ClipToBounds="True">
                <Grid x:Name="RandomSpinContent">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRandomizerSpinning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- Fill and corners hard-coded (black, square) since the Preview Panel flat settings were removed;
                         revisit with the Random Game Display pass (font/color settings for this card). -->
                    <Border x:Name="RandomSpinFallback" CornerRadius="0" Background="#FF000000">
                        <Viewbox Stretch="Uniform" Margin="10">
                            <TextBlock Text="Rolling the Dice!" FontSize="100" FontWeight="Bold" Foreground="{Binding ThemeFolderColor, FallbackValue=#00D4FF}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>
                    <Grid x:Name="RandomSpinFileHost" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <!-- The randomizer spin overlay now lives in the Random Game Display layer (RandomGameDisplayLayer, above). -->

            <!-- [END SECTION: Right Column - Marquee + Media Panels] -->


            

            <Grid x:Name="FooterPanel" Canvas.Left="20" Canvas.Top="700" Width="1240" Height="20">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380*"/>
                <ColumnDefinition Width="900*"/>
            </Grid.ColumnDefinitions>
                
            <!-- Version + Copyright merged into a single pill, right-aligned in Column 1. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                <Border Background="#CC000000" Height="16" BorderBrush="Black" BorderThickness="0" CornerRadius="8" Padding="8,1,8,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Version 1.0.0-beta.4" FontSize="10" FontWeight="Bold" Foreground="DimGray"/>
                        <TextBlock Text=" | " FontSize="10" FontWeight="Bold" Foreground="DimGray"/>
                        <TextBlock Text="© 2026 4RCHIMEDE5" FontSize="10" FontWeight="Bold" Foreground="DimGray"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <!-- [END SECTION: Footer Bar - Games Count + Play Stats + Version/Copyright] -->

            <!-- Theme Builder alignment guides: 1px lines at the selected layer's edges, above every layer,
                 never hit-testable. Positioned, sized and colored by ShowGuides() in code-behind. -->
            <Line x:Name="GuideLeft" Panel.ZIndex="2000" IsHitTestVisible="False" StrokeThickness="1" Visibility="Collapsed" SnapsToDevicePixels="True"/>
            <Line x:Name="GuideRight" Panel.ZIndex="2000" IsHitTestVisible="False" StrokeThickness="1" Visibility="Collapsed" SnapsToDevicePixels="True"/>
            <Line x:Name="GuideTop" Panel.ZIndex="2000" IsHitTestVisible="False" StrokeThickness="1" Visibility="Collapsed" SnapsToDevicePixels="True"/>
            <Line x:Name="GuideBottom" Panel.ZIndex="2000" IsHitTestVisible="False" StrokeThickness="1" Visibility="Collapsed" SnapsToDevicePixels="True"/>
        </Canvas>
        <!-- [END: LayoutCanvas] -->

        <!-- [SECTION: Folder Name Input Flyout] -->
        <!-- Shared by "Create folder" (opens empty, at mouse point) and "Rename folder" (opens pre-
             filled, anchored under the folder row) - code-behind tracks whether a target folder name is
             set to route Enter to the right action. StaysOpen="False" gives click-away-cancels for free. -->
        <Popup x:Name="FolderNameInputPopup" StaysOpen="False" AllowsTransparency="True" Closed="FolderNameInputPopup_Closed">
            <Border Background="{Binding ThemeMainColor, FallbackValue=#1C1C1E}" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1" Padding="8,6">
                <Grid>
                    <TextBox x:Name="FolderNameInputTextBox" Width="220" Height="20" VerticalContentAlignment="Center" FontSize="{Binding Configuration.InputFontSize, FallbackValue=14}" Foreground="{Binding Configuration.InputColorHex, FallbackValue=#F2F2F7}" Background="Transparent" BorderThickness="0" PreviewKeyDown="FolderNameInputTextBox_PreviewKeyDown" TextChanged="FolderNameInputTextBox_TextChanged"/>
                    <!-- Placeholder text - visibility is driven explicitly from code-behind (Create/Rename
                         Click handlers) rather than a DataTrigger, since the trigger could lag a frame
                         behind this Popup's content refresh and render on top of real pre-filled text. -->
                    <TextBlock x:Name="FolderNameInputPlaceholder" Text="Enter folder name" IsHitTestVisible="False" Margin="2,0,0,0"
                               VerticalAlignment="Center" FontSize="{Binding Configuration.InputFontSize, FallbackValue=14}"
                               Foreground="#808080" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Popup>
        <!-- [END SECTION: Folder Name Input Flyout] -->

        <!-- [SECTION: Folder Color Picker Flyout] -->
        <!-- ShowAlpha="False"/HexRepresentation="RGB" deliberately - the tree-build parser only accepts a
             plain 7-char #RRGGBB on a folder's .cfg line 0, an alpha value would silently be discarded on
             the next rebuild. Anchored under the folder row. Live-updates the node's FolderColor as you
             pick; click-away commits to disk, Escape reverts and discards (handled in code-behind). -->
        <Popup x:Name="FolderColorPickerPopup" StaysOpen="False" AllowsTransparency="True" Closed="FolderColorPickerPopup_Closed">
            <Border Background="{Binding ThemeMainColor, FallbackValue=#1C1C1E}" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1" Padding="6">
                <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" Cursor="Hand" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" BorderThickness="1">
                        <colorpicker:PortableColorPicker x:Name="FolderColorPickerControl" Width="26" Height="26" ShowAlpha="False" ColorChanged="FolderColorPickerControl_ColorChanged">
                            <colorpicker:PortableColorPicker.Resources>
                                <!-- Themes the picker's OWN internal popup (the part that opens on click) to
                                     match the rest of the app - AncestorType=Window here resolves to MainWindow
                                     (this flyout's host), so it binds MainViewModel's ThemeMainColor (the Main
                                     Window Background layer's color) and ThemeBorderColor directly. The Theme
                                     Builder's pickers use the shared MainBackgroundBrush resource instead. -->
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="Name" Value="MainGrid">
                                            <Setter Property="Background" Value="{Binding DataContext.ThemeMainColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#1C1C1E}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="colorpicker:HexColorTextBox">
                                    <Style.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorderColor, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#3A3A3C}"/>
                                        </Style>
                                    </Style.Resources>
                                </Style>
                            </colorpicker:PortableColorPicker.Resources>
                        </colorpicker:PortableColorPicker>
                    </Border>
                    <TextBox x:Name="FolderColorHexTextBox" Width="90" Margin="6,0,0,0" VerticalContentAlignment="Center" FontSize="{Binding Configuration.InputFontSize, FallbackValue=14}" Foreground="{Binding Configuration.InputColorHex, FallbackValue=#F2F2F7}" Background="Transparent" BorderBrush="{Binding ThemeBorderColor, FallbackValue=#3A3A3C}" PreviewKeyDown="FolderColorHexTextBox_PreviewKeyDown" LostFocus="FolderColorHexTextBox_LostFocus"/>
                </StackPanel>
            </Border>
        </Popup>
        <!-- [END SECTION: Folder Color Picker Flyout] -->

        <!-- [SECTION: Randomizer Confirm Flyout] -->
        <!-- Anchored under the die button (BtnPlayRandom) - guards against accidental clicks before any
             spin logic runs. Spin/Cancel mirror the Border+MouseLeftButtonUp button pattern used
             elsewhere in this file rather than a real Button control, for visual consistency. -->
        <!-- Randomizer confirm popup removed - the die button now spins immediately. -->
        <!-- [END SECTION: Randomizer Confirm Flyout] -->

        <!-- [SECTION: Randomizer Reveal Flyout] -->
        <!-- Anchored under the die button, same spot as the Confirm popup. StaysOpen="False" so a
             stray click outside the popup dismisses it (same behavior as Confirm) instead of it
             lingering on top of every other window until explicitly clicked - RandomizerRevealPopup_Closed
             below does the same cleanup the Cancel button does, so an outside-click dismiss behaves
             identically to hitting Cancel rather than leaving randomizer state stuck open. -->
        <!-- Randomizer reveal popup removed - the spin now lands on the winner in the list. -->
        <!-- [END SECTION: Randomizer Reveal Flyout] -->
    </Grid>
</Window>