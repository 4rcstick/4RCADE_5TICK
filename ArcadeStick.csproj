<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWpf>true</UseWpf>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PlatformTarget>x64</PlatformTarget>

		<PublishSingleFile>true</PublishSingleFile>

		<IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>

		<ApplicationIcon>Assets\arcade.ico</ApplicationIcon>
		<AssemblyName>4RCADE5TICK</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AnimatedImage.Wpf" Version="2.1.4" />
		<PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
		<PackageReference Include="System.Management" Version="10.0.0-preview.2.25163.2" />
	</ItemGroup>

	<!-- FFmpeg runtime for the game-preview player: the five DLLs plus their notices and licenses are copied
	     to 4rcade5tick_files\ffmpeg in the publish output (loose beside the exe, not bundled into it).
	     Publish only - debug runs use the 4rcade5tick_files folder that boot.cfg or the exe folder points to. -->
	<ItemGroup>
		<None Update="ffmpeg\**\*" CopyToPublishDirectory="PreserveNewest" Link="4rcade5tick_files\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

</Project>